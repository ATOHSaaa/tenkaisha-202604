# ==========================================================================
# 転回社 Web / Lolipop (Apache) .htaccess
# --------------------------------------------------------------------------
# - 旧 ink.tenkai.org からのページを新サイト（tenkai.org）へリダイレクト
# - 一般的な WordPress 由来のパーマリンクを新サイトの該当ページへ誘導
# - 基本的に 301（恒久リダイレクト）
# --------------------------------------------------------------------------
# ※ tenkai.org（本サイト）配下に配置してください。
# ※ ink.tenkai.org 側ドメインについては、DNS／ドメイン設定で
#    tenkai.org にリダイレクト or エイリアスする運用を推奨します。
# ==========================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ------------------------------------------------------------------
  # 旧 ink.tenkai.org から来たアクセスを新サイトの対応ページへ誘導
  # ※ ドメインが違う場合は、ドメイン側で A/CNAME を tenkai.org に
  #    寄せつつ、ここで URL を新しい階層にマッピングします。
  # ------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^ink\.tenkai\.org$ [NC]
  RewriteRule ^stage-info/?$ https://tenkai.org/events/ [L,R=301]

  RewriteCond %{HTTP_HOST} ^ink\.tenkai\.org$ [NC]
  RewriteRule ^juniorclass/?$ https://tenkai.org/classes/junior/ [L,R=301]

  RewriteCond %{HTTP_HOST} ^ink\.tenkai\.org$ [NC]
  RewriteRule ^blog/?$ https://tenkai.org/blog/ [L,R=301]

  RewriteCond %{HTTP_HOST} ^ink\.tenkai\.org$ [NC]
  RewriteRule ^category/(.*)$ https://tenkai.org/blog/ [L,R=301]

  # WordPress の年月日系パーマリンクをブログ一覧に寄せる
  RewriteCond %{HTTP_HOST} ^ink\.tenkai\.org$ [NC]
  RewriteRule ^[0-9]{4}/[0-9]{2}/(.*)$ https://tenkai.org/blog/ [L,R=301]

  # ink.tenkai.org への任意のアクセスは、とりあえず新サイトのトップへ
  RewriteCond %{HTTP_HOST} ^ink\.tenkai\.org$ [NC]
  RewriteRule ^(.*)$ https://tenkai.org/$1 [L,R=301]

  # ------------------------------------------------------------------
  # 旧 tenkai.org 側の旧URL（静的HTML時代）を新しいパスに寄せる
  # ------------------------------------------------------------------
  RewriteRule ^about\.html$ /about/ [L,R=301]
  RewriteRule ^school\.html$ /requests/school/ [L,R=301]
  RewriteRule ^member\.html$ /requests/members/ [L,R=301]
  RewriteRule ^recruit/?$ /requests/members/ [L,R=301]

  # 旧 /performances/ を公演・イベント一覧へ
  RewriteRule ^performances/?$ /events/ [L,R=301]
  RewriteRule ^performances/(.+)/?$ /events/$1/ [L,R=301]

  # ------------------------------------------------------------------
  # 末尾スラッシュ統一（ディレクトリに対して / を付与）
  # ------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# ==========================================================================
# エラードキュメント
# ==========================================================================
ErrorDocument 404 /404.html

# ==========================================================================
# MIME / 文字コード
# ==========================================================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .svg

# ==========================================================================
# キャッシュ制御（静的アセット）
# ==========================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ==========================================================================
# gzip/deflate 圧縮
# ==========================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==========================================================================
# セキュリティヘッダ（最低限）
# ==========================================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
