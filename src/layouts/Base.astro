---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ClientRouter } from 'astro:transitions';
import { buildBreadcrumbs, type BreadcrumbItem } from '../utils/breadcrumbs';
import { withBase, stripBasePath } from '../utils/path';
import { THEME_USER_CHOICE_ENABLED } from '../scripts/theme';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** false のとき h2・カードのスクロール表示アニメーションを無効化 */
  scrollReveal?: boolean;
  /** 未指定時は URL + title から自動生成。配列で上書き可 */
  breadcrumbs?: BreadcrumbItem[];
  /** 最終 crumb のラベル（title と異なるとき） */
  breadcrumbLabel?: string;
}

const {
  title,
  description = '熊本を拠点に活動する劇団「転回社」の公式サイト。公演情報、開講クラス、演劇教育、スタジオ情報をご案内します。',
  ogImage = '/images/ogp.png',
  scrollReveal = false,
  breadcrumbs: breadcrumbsProp,
  breadcrumbLabel,
} = Astro.props;

const siteName = '転回社';
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} | 熊本を拠点に活動する劇団`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbItems =
  breadcrumbsProp ??
  buildBreadcrumbs(Astro.url.pathname, breadcrumbLabel ?? title, Astro.url.searchParams);

const pathname = stripBasePath(Astro.url.pathname).replace(/\/+$/, '') || '/';
const isHome = pathname === '/';

const breadcrumbJsonLd =
  breadcrumbItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: item.href
            ? new URL(item.href, Astro.site).href
            : index === breadcrumbItems.length - 1
              ? canonical
              : undefined,
        })),
      }
    : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    {
      THEME_USER_CHOICE_ENABLED ? (
        <script is:inline>
          (function () {
            try {
              var k = 'tenkaisha-theme';
              var s = localStorage.getItem(k);
              var d =
                s === 'dark' ||
                (s !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
              if (d) document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) {}
          })();
        </script>
      ) : (
        <script is:inline>
          document.documentElement.removeAttribute('data-theme');
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    {
      breadcrumbJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase(ogImage), Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjTHNB6z8Enl0lSDu9YwOAn/nbZ0nFzZ6A/rJVSXU3iaPPow=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <ClientRouter />
  </head>
  <body data-scroll-reveal={scrollReveal ? 'on' : 'off'}>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main">
      <div class:list={['breadcrumb-bar', isHome && 'breadcrumb-bar--home']}>
        <div class="container breadcrumb-bar__inner">
          <Breadcrumbs items={breadcrumbItems} />
        </div>
      </div>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      /** ページ内 # リンクだけスムーズスクロール（履歴復元は auto のまま） */
      document.addEventListener(
        'click',
        (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)
            return;
          const a = e.target.closest('a[href^="#"]');
          if (!a || !a.hash || a.hash === '#') return;
          const id = a.hash.slice(1);
          const target = document.getElementById(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        },
        true,
      );
    </script>
    <script>
      import { initScrollReveal } from '../scripts/scroll-reveal';
      import { initTheme, initThemeToggle } from '../scripts/theme';
      import { initPageHeaderEyecatchEnter } from '../scripts/page-header-eyecatch-enter';
      import { initHomeSideMarquees } from '../scripts/home-side-marquee';

      initTheme();
      initThemeToggle();
      initScrollReveal();
      initPageHeaderEyecatchEnter();
      initHomeSideMarquees();
      document.addEventListener('astro:page-load', () => {
        initTheme();
        initThemeToggle();
        initScrollReveal();
        initPageHeaderEyecatchEnter();
        initHomeSideMarquees();
      });
    </script>

    
  </body>
</html>
