---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ClientRouter } from 'astro:transitions';
import { buildBreadcrumbs, type BreadcrumbItem } from '../utils/breadcrumbs';
import { withBase, stripBasePath } from '../utils/path';
import { THEME_USER_CHOICE_ENABLED } from '../scripts/theme';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** false のとき h2・カードのスクロール表示アニメーションを無効化 */
  scrollReveal?: boolean;
  /** 未指定時は URL + title から自動生成。配列で上書き可 */
  breadcrumbs?: BreadcrumbItem[];
  /** 最終 crumb のラベル（title と異なるとき） */
  breadcrumbLabel?: string;
}

const {
  title,
  description = '熊本を拠点に活動する劇団「転回社」の公式サイト。公演情報、開講クラス、演劇教育、スタジオ情報をご案内します。',
  ogImage = '/images/ogp.png',
  scrollReveal = false,
  breadcrumbs: breadcrumbsProp,
  breadcrumbLabel,
} = Astro.props;

const siteName = '転回社';
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} | 熊本を拠点に活動する劇団`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbItems =
  breadcrumbsProp ??
  buildBreadcrumbs(Astro.url.pathname, breadcrumbLabel ?? title, Astro.url.searchParams);

const pathname = stripBasePath(Astro.url.pathname).replace(/\/+$/, '') || '/';
const isHome = pathname === '/';

const breadcrumbJsonLd =
  breadcrumbItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: item.href
            ? new URL(item.href, Astro.site).href
            : index === breadcrumbItems.length - 1
              ? canonical
              : undefined,
        })),
      }
    : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline define:vars={{ scrollMotionKey: 'tenkaisha-scroll-motion' }}>
      (function () {
        try {
          var s = localStorage.getItem(scrollMotionKey);
          document.documentElement.setAttribute('data-scroll-motion', s === 'off' ? 'off' : 'on');
        } catch (e) {
          document.documentElement.setAttribute('data-scroll-motion', 'on');
        }
      })();
    </script>
    <style is:inline>
      html:not([data-scroll-motion='on']) .home-hero__marquee-track,
      html:not([data-scroll-motion='on']) .home-news-marquee__track,
      html:not([data-scroll-motion='on']) .home-side-marquee__col-track {
        animation: none !important;
      }
      html:not([data-scroll-motion='on']) .home-hero__img--primary,
      html:not([data-scroll-motion='on']) .home-hero__img--alt {
        animation: none !important;
      }
      html:not([data-scroll-motion='on']) .scroll-reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      html:not([data-scroll-motion='on']) .page-header__eyecatch,
      html:not([data-scroll-motion='on']) .page-header__eyecatch.page-header__eyecatch--ready {
        visibility: visible !important;
      }
      html:not([data-scroll-motion='on']) .page-header__eyecatch-char,
      html:not([data-scroll-motion='on']) .page-header__eyecatch-char.page-header__eyecatch-char--enter {
        opacity: 1 !important;
        transform: none !important;
        animation: none !important;
      }
    </style>
    {
      THEME_USER_CHOICE_ENABLED ? (
        <script is:inline>
          (function () {
            try {
              var k = 'tenkaisha-theme';
              var s = localStorage.getItem(k);
              var d =
                s === 'dark' ||
                (s !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
              if (d) document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) {}
          })();
        </script>
      ) : (
        <script is:inline>
          document.documentElement.removeAttribute('data-theme');
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    {
      breadcrumbJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase(ogImage), Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjTHNB6z8Enl0lSDu9YwOAn/nbZ0nFzZ6A/rJVSXU3iaPPow=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <ClientRouter />
  </head>
  <body class:list={[isHome && 'page-home']} data-scroll-reveal={scrollReveal ? 'on' : 'off'}>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main" tabindex="-1">
      <div class:list={['breadcrumb-bar', isHome && 'breadcrumb-bar--home']}>
        <div class="container breadcrumb-bar__inner">
          <Breadcrumbs items={breadcrumbItems} />
        </div>
      </div>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      /** ページ内 # リンクだけスムーズスクロール（履歴復元は auto のまま） */
      document.addEventListener(
        'click',
        (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)
            return;
          const a = e.target.closest('a[href^="#"]');
          if (!a || !a.hash || a.hash === '#') return;
          const id = a.hash.slice(1);
          const target = document.getElementById(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({
            behavior:
              document.documentElement.dataset.scrollMotion === 'off' ||
              window.matchMedia('(prefers-reduced-motion: reduce)').matches
                ? 'auto'
                : 'smooth',
          });
        },
        true,
      );
    </script>
    <script>
      import { initScrollMotionToggle, syncScrollMotionToggleUI } from '../scripts/scroll-motion';
      import { initScrollReveal } from '../scripts/scroll-reveal';
      import { initTheme, initThemeToggle } from '../scripts/theme';
      import { initScrollMotionFromStorage } from '../scripts/scroll-motion-prefs';
      import { initPageHeaderEyecatchEnter } from '../scripts/page-header-eyecatch-enter';
      import { initHomeSideMarquees } from '../scripts/home-side-marquee';

      function syncScrollMotionForNavigation() {
        initScrollMotionFromStorage();
        syncScrollMotionToggleUI();
      }

      function initAfterNavigation() {
        syncScrollMotionForNavigation();
        initTheme();
        initThemeToggle();
        initScrollReveal();
        initPageHeaderEyecatchEnter();
        initHomeSideMarquees();
      }

      initAfterNavigation();
      initScrollMotionToggle();
      document.addEventListener('astro:before-swap', syncScrollMotionForNavigation);
      document.addEventListener('astro:page-load', () => {
        initAfterNavigation();
        initScrollMotionToggle();
      });
    </script>

    
  </body>
</html>
