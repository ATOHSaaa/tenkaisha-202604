---
interface Props {
  jp: string;
  note?: string;
  /** 見出し h2 に追加する class（例: トップ「転回社の活動」専用） */
  headingClass?: string;
  /** 見出しブロックをスクロール表示（fade + slide） */
  scrollReveal?: boolean;
  /** 見出し直下の説明文（改行は \n） */
  lead?: string;
}

const { jp, note, headingClass, scrollReveal, lead } = Astro.props;
/** `|` で preferred break（狭い幅ではここで改行、広い幅では1行） */
const leadBreakParts =
  lead && lead.includes('|') ? (lead.split('|', 2) as [string, string]) : null;
const leadLines =
  lead && !leadBreakParts ? lead.split('\n').filter(Boolean) : [];
---

<header class:list={['section-head', scrollReveal && 'section-head--scroll-reveal']}>
  <div class="section-head__title-row">
    <h2 class:list={['section-head__jp', 'heading-section', headingClass]}>{jp}</h2>
    {note && <span class="section-head__note">{note}</span>}
  </div>
  {
    leadBreakParts && (
      <p class="section-head__lead section-head__lead--pref-break">
        <span class="section-head__lead-before">{leadBreakParts[0]}</span>
        <span class="section-head__lead-after">{leadBreakParts[1]}</span>
      </p>
    )
  }
  {
    leadLines.length > 0 && (
      <p class="section-head__lead">
        {leadLines.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    )
  }
</header>
