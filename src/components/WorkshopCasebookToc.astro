---
import type { WorkshopCasebookTocItem } from '../data/workshop-casebook';
import { workshopCasebookToc } from '../data/workshop-casebook';
import { withBase } from '../utils/path';

interface Props {
  items?: WorkshopCasebookTocItem[];
}

const { items = workshopCasebookToc } = Astro.props;
---

<nav class="casebook-toc" aria-label="目次">
  <ul class="casebook-toc__list">
    {
      items.map((item) => (
        <li class="casebook-toc__item">
          <span class="casebook-toc__label">{item.label}</span>
          {item.title ? (
            <>
              {'　'}
              {item.href ? (
                <a class="casebook-toc__title casebook-toc__title--link" href={withBase(item.href)}>
                  {item.title}
                </a>
              ) : (
                <span class="casebook-toc__title">{item.title}</span>
              )}
            </>
          ) : null}
        </li>
      ))
    }
  </ul>
</nav>
