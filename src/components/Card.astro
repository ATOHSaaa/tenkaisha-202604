---
import { formatShowTitle, splitShowTitleBeforeWork } from '../utils/titles';
import EventBadge from './EventBadge.astro';
import type { EventBadge as EventBadgeData } from '../utils/event-content';
import { withBase } from '../utils/path';

interface Props {
  href?: string;
  image?: string;
  label?: string;
  /** @deprecated badges を使用 */
  badge?: string;
  /** @deprecated badges を使用 */
  badgeVariant?: 'long-run' | 'event' | 'junior';
  badges?: EventBadgeData[];
  nextPerformanceDate?: Date;
  /** performanceHistory 由来の表示（例: 11月8日(土) 19:00） */
  nextPerformanceDateText?: string;
  /** time[datetime] 用（YYYY-MM-DD・JST 暦日） */
  nextPerformanceDateTime?: string;
  /** 日付ブロックの見出し（既定: 次回） */
  nextDateLabel?: string;
  /** @deprecated nextPerformanceDate + nextDateLabel を使用 */
  scheduleText?: string;
  title: string;
  body?: string;
  external?: boolean;
  imageAspect?: string;
  /** ニュースサイドバー: チラシ左・タイトル＋日付を右に縦並び */
  /** 開講クラス: PCは縦積み、狭い幅でチラシ左・テキスト右 */
  /** 公演アーカイブ: タグ → チラシ → タイトルの縦積み */
  layout?: 'default' | 'sidebar' | 'classFlyer' | 'archive';
  /** src を付けず data-defer-src のみ（公演一覧アーカイブ向け） */
  deferImage?: boolean;
}

const {
  href,
  image,
  label,
  badge,
  badgeVariant,
  badges: badgesProp,
  nextPerformanceDate,
  nextPerformanceDateText,
  nextPerformanceDateTime,
  nextDateLabel = '次回',
  scheduleText,
  title,
  body,
  external,
  imageAspect,
  layout = 'default',
  deferImage = false,
} = Astro.props;
const badgeList =
  badgesProp ?? (badge ? [{ badge, badgeVariant }] : []);
const titleParts = splitShowTitleBeforeWork(title);
const displayTitle = formatShowTitle(title);
const Tag = href ? 'a' : 'div';
const extAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

function nextDateDisplay() {
  if (nextPerformanceDateText) return nextPerformanceDateText;
  if (nextPerformanceDate) return fmtDate(nextPerformanceDate);
  return '';
}

function nextDateDatetime() {
  if (nextPerformanceDateTime) return nextPerformanceDateTime;
  if (nextPerformanceDate) return nextPerformanceDate.toISOString();
  return undefined;
}

const sidebarLayout = layout === 'sidebar' && Boolean(image);
const classFlyerLayout = layout === 'classFlyer' && Boolean(image);
const archiveLayout = layout === 'archive' && Boolean(image);

function resolveHref(raw?: string) {
  if (!raw) return undefined;
  if (external || /^https?:\/\//i.test(raw)) return raw;
  return withBase(raw);
}

const imageSrc = image && !/^https?:\/\//i.test(image) ? withBase(image) : image;
const deferImageLoad = deferImage && Boolean(imageSrc);
const linkHref = resolveHref(href);
---

<Tag
  class:list={[
    'card',
    sidebarLayout && 'card--sidebar',
    classFlyerLayout && 'card--class-flyer',
    archiveLayout && 'card--archive',
  ]}
  href={linkHref}
  {...extAttrs}
>
  {
    badgeList.length > 0 && !sidebarLayout && (
      <div class="card__badges">
        {badgeList.map((item) => (
          <EventBadge badge={item.badge} badgeVariant={item.badgeVariant} />
        ))}
      </div>
    )
  }
  {
    classFlyerLayout ? (
      <div class="card__class-stack">
        <div class="card__thumb-frame">
          <img
            class="card__thumb"
            src={imageSrc}
            alt=""
            loading="lazy"
            style={imageAspect ? `aspect-ratio:${imageAspect}` : undefined}
          />
        </div>
        <h3 class="card__title">
          {
            titleParts ? (
              <>
                {titleParts.lead}
                <wbr />
                {titleParts.work}
              </>
            ) : (
              displayTitle
            )
          }
        </h3>
        {body && <p class="card__body">{body}</p>}
      </div>
    ) : archiveLayout ? (
      <div class="card__visual card__visual--archive">
        <div class="card__thumb-frame">
          {
            deferImageLoad ? (
              <img
                class="card__thumb"
                alt=""
                data-defer-src={imageSrc}
                decoding="async"
                style={imageAspect ? `aspect-ratio:${imageAspect}` : undefined}
              />
            ) : (
              <img
                class="card__thumb"
                src={imageSrc}
                alt=""
                loading="lazy"
                style={imageAspect ? `aspect-ratio:${imageAspect}` : undefined}
              />
            )
          }
        </div>
        <h3 class="card__title">
          {
            titleParts ? (
              <>
                {titleParts.lead}
                <wbr />
                {titleParts.work}
              </>
            ) : (
              displayTitle
            )
          }
        </h3>
      </div>
    ) : sidebarLayout ? (
      <div class="card__visual card__visual--sidebar">
        <div class="card__thumb-frame">
          <img
            class="card__thumb"
            src={imageSrc}
            alt=""
            loading="lazy"
            style={imageAspect ? `aspect-ratio:${imageAspect}` : undefined}
          />
        </div>
        <div class="card__meta">
          {
            badgeList.length > 0 && (
              <div class="card__badges card__badges--meta">
                {badgeList.map((item) => (
                  <EventBadge badge={item.badge} badgeVariant={item.badgeVariant} />
                ))}
              </div>
            )
          }
          <h3 class="card__title">
            {
              titleParts ? (
                <>
                  {titleParts.lead}
                  <wbr />
                  {titleParts.work}
                </>
              ) : (
                displayTitle
              )
            }
          </h3>
          {body && <p class="card__body">{body}</p>}
          {
            nextPerformanceDate || nextPerformanceDateText ? (
              <p class="card__next">
                <span class="card__next-label">{nextDateLabel}</span>
                <time class="card__next-date" datetime={nextDateDatetime()}>
                  {nextDateDisplay()}
                </time>
              </p>
            ) : scheduleText ? (
              <p class="card__next">
                <span class="card__next-date card__next-date--schedule">{scheduleText}</span>
              </p>
            ) : (
              label && <span class="card__label">{label}</span>
            )
          }
        </div>
      </div>
    ) : image ? (
      <div class="card__visual">
        <h3 class="card__title">
          {
            titleParts ? (
              <>
                {titleParts.lead}
                <wbr />
                {titleParts.work}
              </>
            ) : (
              displayTitle
            )
          }
        </h3>
        <div class="card__thumb-frame">
          <img
            class="card__thumb"
            src={imageSrc}
            alt=""
            loading="lazy"
            style={imageAspect ? `aspect-ratio:${imageAspect}` : undefined}
          />
        </div>
      </div>
    ) : (
      <h3 class="card__title">
        {
          titleParts ? (
            <>
              {titleParts.lead}
              <wbr />
              {titleParts.work}
            </>
          ) : (
            displayTitle
          )
        }
      </h3>
    )
  }
  {
    !sidebarLayout &&
      !classFlyerLayout &&
      !archiveLayout &&
      (nextPerformanceDate ? (
        <p class="card__next">
          <span class="card__next-label">{nextDateLabel}</span>
          <time class="card__next-date" datetime={nextDateDatetime()}>
            {nextDateDisplay()}
          </time>
        </p>
      ) : scheduleText ? (
        <p class="card__next">
          <span class="card__next-date card__next-date--schedule">{scheduleText}</span>
        </p>
      ) : (
        label && <span class="card__label">{label}</span>
      ))
  }
  {body && !classFlyerLayout && !sidebarLayout && !archiveLayout && (
    <p class="card__body">{body}</p>
  )}
  <slot />
</Tag>
