---
import type { ClassEntry } from '../utils/classes-content';
import { getClassAppendEntries } from '../utils/classes-content';
import { render } from 'astro:content';
import ClassInstructors from './ClassInstructors.astro';
import ClassAppendRecords from './ClassAppendRecords.astro';
import PageHeader from './PageHeader.astro';
import { withBase } from '../utils/path';

function appendUsesRecordTables(entry: ClassEntry) {
  return (
    (entry.data.activityRecords?.length ?? 0) > 0 ||
    (entry.data.mediaAppearances?.length ?? 0) > 0
  );
}

interface Props {
  entry: ClassEntry;
}

const { entry } = Astro.props;
const c = entry.data;
const instructors = c.instructors ?? [];
const appendEntries = await getClassAppendEntries(entry.id);
const appendBlocks = await Promise.all(
  appendEntries.map(async (appendEntry) => {
    if (appendUsesRecordTables(appendEntry)) {
      return { kind: 'records' as const, entry: appendEntry };
    }
    const { Content } = await render(appendEntry);
    return { kind: 'md' as const, Content };
  }),
);
const { Content } = await render(entry);
const coverSrc = c.image ? withBase(c.image) : undefined;
---

<PageHeader jp={c.title} />
<section class="cd__body container">
  <div class="cd__grid">
    <div class="prose cd__prose">
      <Content />
      {instructors.length > 0 && <ClassInstructors instructors={instructors} />}
    </div>

    <aside class="cd__side">
      {
        c.coverFit === 'contain' ? (
          <div class="cd__cover-wrap cd__cover-wrap--chira">
            <img class="cd__cover cd__cover--contain" src={coverSrc} alt="" />
          </div>
        ) : (
          <img class="cd__cover" src={coverSrc} alt="" />
        )
      }
      <dl class="cd__meta">
        {c.schedule && <div><dt>稽古日</dt><dd>{c.schedule}</dd></div>}
        {c.target && <div><dt>対象</dt><dd>{c.target}</dd></div>}
        {c.fee && <div><dt>月謝</dt><dd>{c.fee}</dd></div>}
      </dl>
      <a class="btn btn--pill" href={withBase('/contact/')}>体験参加を申し込む <span class="btn__arrow">→</span></a>
    </aside>
  </div>

  {
    appendBlocks.length > 0 ? (
      <div class="cd__below prose">
        {
          appendBlocks.map((block) => (
            <div class="cd__append">
              {
                block.kind === 'records' ? (
                  <ClassAppendRecords
                    activityRecords={block.entry.data.activityRecords}
                    mediaAppearances={block.entry.data.mediaAppearances}
                  />
                ) : (
                  <block.Content />
                )
              }
            </div>
          ))
        }
      </div>
    ) : null
  }

  <div class="cd__back">
    <a class="link-arrow" href={withBase('/classes/')}>← 開講クラスへ戻る</a>
  </div>
</section>
