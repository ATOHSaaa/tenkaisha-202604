---
// フッター。SNSリンク先はダミー。後ほど URL 差し替えてください。
const social: { label: string; url: string }[] = [
  { label: 'X', url: 'https://x.com/' },
  { label: 'Instagram', url: 'https://www.instagram.com/' },
  { label: 'YouTube', url: 'https://www.youtube.com/' },
  { label: 'Facebook', url: 'https://www.facebook.com/' },
];

const nav: { heading: string; items: { label: string; href: string }[] }[] = [
  {
    heading: '転回社について',
    items: [
      { label: '劇団員紹介', href: '/members/' },
      { label: '演劇と教育', href: '/education/' },
      { label: '法人の方向け', href: '/for-organizations/' },
      { label: 'スタジオ所在地', href: '/#studios' },
      { label: 'お問い合わせ', href: '/contact/' },
    ],
  },
  {
    heading: '活動',
    items: [
      { label: '公演・イベント', href: '/stages/' },
      { label: '開講クラス', href: '/classes/' },
      { label: '刊行物', href: '/publications/' },
      { label: '日々のこと', href: '/blog/' },
      { label: 'おしらせ', href: '/news/' },
    ],
  },
];

---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="site-footer__name">一般社団法人 転回社</p>
        <address class="site-footer__addr">
          <span>〒862-0950</span>
          <span>熊本県熊本市中央区水前寺 1-32-28-202</span>
          <span>TEL 080-1770-8318 / FAX 096-323-7267</span>
          <span>
            <a href="mailto:office@tenkai.org">office@tenkai.org</a>
          </span>
        </address>
      </div>

      <nav class="site-footer__nav" aria-label="フッターメニュー">
        {
          nav.map((group) => (
            <div class="site-footer__group">
              <p class="site-footer__group-title">{group.heading}</p>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="site-footer__bottom">
      <ul class="site-footer__social" aria-label="SNS">
        {
          social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="site-footer__credit">
        制作：<a href="https://production.tadeku.net/" target="_blank" rel="noopener noreferrer">蓼食う本の虫制作室</a>
      </p>
    </div>
  </div>
</footer>
