---
import type { RequestInfo } from '../data/site';
import PageContactCta from './PageContactCta.astro';
import { withBase } from '../utils/path';

interface Props {
  info: RequestInfo;
  description: string;
  /** description の直後に続く段落（学校公演ページなど） */
  descriptionExtra?: string;
  points?: string[];
  backHref?: string;
  backLabel?: string;
  /** false で黒帯ヒーローを出さない（PageHeader 等と併用） */
  showHero?: boolean;
  /** false で右カラム（画像・ボタン）を出さない */
  showSidebar?: boolean;
}

const {
  info,
  description,
  descriptionExtra,
  points = [],
  backHref = '/education/',
  backLabel = '演劇と教育へ戻る',
  showHero = true,
  showSidebar = true,
} = Astro.props;
const resolvedBackHref = withBase(backHref);
---

{
  showHero && (
    <section class="rd__hero">
      <div class="container rd__hero-inner">
        <h1 class="rd__jp heading-section">{info.name}</h1>
        <p class="rd__lead">{info.summary}</p>
      </div>
    </section>
  )
}

<section class="rd__body container">
  {
    showSidebar ? (
      <div class="rd__grid">
        <div class="prose">
          {description ? <p>{description}</p> : null}
          {descriptionExtra ? <p>{descriptionExtra}</p> : null}
          {
            points.length > 0 && (
              <>
                <h2>ご提供できること</h2>
                <ul>
                  {points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </>
            )
          }
          <slot name="before-contact" />
          <PageContactCta />
        </div>

        <aside class="rd__side">
          <img class="rd__cover" src={withBase(info.image)} alt="" />
          <a class="btn btn--pill" href={withBase('/contact/')}>お問い合わせ <span class="btn__arrow">→</span></a>
        </aside>
      </div>
    ) : (
      <div class="prose">
        {description ? <p>{description}</p> : null}
        {descriptionExtra ? <p>{descriptionExtra}</p> : null}
        {
          points.length > 0 && (
            <>
              <h2>ご提供できること</h2>
              <ul>
                {points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </>
          )
        }
        <slot name="before-contact" />
        <PageContactCta />
      </div>
    )
  }

  <div class="rd__back">
    <a class="link-arrow" href={resolvedBackHref}>← {backLabel}</a>
  </div>
</section>
