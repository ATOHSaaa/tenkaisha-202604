---
import { withBase } from '../utils/path';

interface Props {
  body: string;
  href?: string;
  buttonLabel?: string;
}

const { body, href = '/contact/', buttonLabel = 'お問い合わせへ' } = Astro.props;
---

<div class="page-contact-cta">
  <p>{body}</p>
  <a class="btn" href={withBase(href)}>
    {buttonLabel} <span class="btn__arrow">→</span>
  </a>
</div>
