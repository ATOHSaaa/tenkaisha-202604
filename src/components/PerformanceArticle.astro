---
import PageHeader from './PageHeader.astro';
import PerformanceHistory from './PerformanceHistory.astro';
import PerformanceTickets from './PerformanceTickets.astro';
import { render } from 'astro:content';
import type { PerformanceEntry } from '../utils/event-content';
import { eventDetailBadges } from '../utils/event-content';
import { pastPerformanceHistoryItems } from '../utils/performance-history';
import { buildPeatixLinkResolver } from '../utils/peatix-history-links';
import { formatShowTitle } from '../utils/titles';
import { withBase } from '../utils/path';

interface Props {
  entry: PerformanceEntry;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const showTitle = formatShowTitle(entry.data.title);
const pastHistory = pastPerformanceHistoryItems(entry.data.performanceHistory);
const resolvePeatixLink = buildPeatixLinkResolver({
  title: entry.data.title,
  body: entry.body,
  tickets: 'tickets' in entry.data ? entry.data.tickets : undefined,
});
const isLongRun = entry.data.type === 'long-run';
const tickets = 'tickets' in entry.data ? entry.data.tickets : undefined;
const typeBadges = eventDetailBadges(entry.data);
---

<article class="perf">
  <PageHeader
    jp={showTitle}
    compact
    badges={typeBadges}
    badgeAlignCover={Boolean(entry.data.cover)}
  />

  <section class="container perf__body">
    <div class="perf__grid">
      <div class="prose perf__prose">
        <Content />
        {
          isLongRun && pastHistory.length > 0 && (
            <PerformanceHistory
              items={pastHistory}
              resolveLink={resolvePeatixLink}
              includeTime={isLongRun}
            />
          )
        }
      </div>
      {
        entry.data.cover && (
          <aside class="perf__side">
            <div class="perf__side-inner">
              <img
                class="perf__cover"
                src={withBase(entry.data.cover)}
                alt=""
                loading="lazy"
                decoding="async"
              />
              {tickets && tickets.length > 0 && (
                <PerformanceTickets tickets={tickets} variant="sidebar" />
              )}
            </div>
          </aside>
        )
      }
    </div>
  </section>
</article>
