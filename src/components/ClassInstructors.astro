---
import { withBase } from '../utils/path';

export type ClassInstructor = {
  name: string;
  photo: string;
  bio: string;
  photoScale?: number;
  photoShiftY?: number;
};

interface Props {
  instructors: ClassInstructor[];
}

const { instructors } = Astro.props;
---

{
  instructors.length > 0 && (
    <section class="class-instructors" aria-labelledby="class-instructors-title">
      <h2 id="class-instructors-title" class="class-instructors__title">
        講師
      </h2>
      <ul class="class-instructors__list">
        {
          instructors.map((person) => (
            <li class="class-instructor">
              <p class="class-instructor__name">{person.name}</p>
              <div
                class="class-instructor__photo-frame"
                style={
                  person.photoScale || person.photoShiftY != null
                    ? {
                        ...(person.photoScale != null && {
                          '--photo-scale': String(person.photoScale),
                        }),
                        ...(person.photoShiftY != null && {
                          '--photo-shift-y': `${person.photoShiftY}%`,
                        }),
                      }
                    : undefined
                }
              >
                <img
                  class:list={[
                    'class-instructor__photo',
                    person.photoScale && 'class-instructor__photo--scaled',
                  ]}
                  src={withBase(person.photo)}
                  alt=""
                  width={248}
                  height={300}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <p class="class-instructor__bio">{person.bio}</p>
            </li>
          ))
        }
      </ul>
    </section>
  )
}
