---
import HeaderBrandCube from './HeaderBrandCube.astro';
import { siteHeaderNav, isSiteNavCurrent } from '../data/site-nav';
import { withBase, stripBasePath } from '../utils/path';
import { THEME_USER_CHOICE_ENABLED } from '../scripts/theme';

const navId = 'site-header-nav';
const currentPath = stripBasePath(Astro.url.pathname);
---

<div class="site-header-root" transition:persist="site-header" transition:animate="none">
  <div class="site-header__inner container">
    <div class="site-header__start">
      <a class="site-header__brand" href={withBase('/')} aria-label="転回社 トップへ">
        <HeaderBrandCube />
        <span class="site-header__logo">転回社</span>
      </a>
      <div class="site-header__scroll-progress-wrap">
        <span class="site-header__scroll-progress" aria-hidden="true">
          <span class="site-header__scroll-progress-bar"></span>
        </span>
        <span class="site-header__scroll-progress-label" aria-hidden="true"></span>
      </div>
    </div>

    <div class="site-header__end">
      <button
        type="button"
        class="site-header__menu-toggle"
        aria-expanded="false"
        aria-controls={navId}
        aria-label="メニューを開く"
        data-site-header-toggle
      >
        <span class="site-header__menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

    <nav class="site-header__nav" id={navId} aria-label="サイト内メニュー">
      <span class="site-header__nav-indicator" aria-hidden="true"></span>
      <ul class="site-header__nav-list">
        {
          THEME_USER_CHOICE_ENABLED ? (
            <li class="site-header__nav-item site-header__nav-item--theme">
              <button
                type="button"
                class="site-header__theme-toggle"
                aria-label="ダークモードに切り替え"
                aria-pressed="false"
                data-theme-toggle
              >
                <i
                  class="fa-solid fa-moon site-header__theme-icon site-header__theme-icon--moon"
                  aria-hidden="true"
                />
                <i
                  class="fa-solid fa-sun site-header__theme-icon site-header__theme-icon--sun"
                  aria-hidden="true"
                />
                <span class="sr-only">表示モード切替</span>
              </button>
            </li>
          ) : null
        }
        {
          siteHeaderNav.map((item) => {
            const isCurrent = isSiteNavCurrent(currentPath, item.href);
            return (
            <li
              class:list={[
                'site-header__nav-item',
                item.href === '/contact/' && 'site-header__nav-item--contact',
              ]}
            >
              <a
                class:list={[
                  'site-header__link',
                  item.href === '/contact/' && 'site-header__link--cta',
                  isCurrent && 'site-header__link--current',
                ]}
                href={withBase(item.href)}
                data-nav-href={item.href}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
            );
          })
        }
        <li class="site-header__nav-item site-header__nav-item--motion">
          <button
            type="button"
            class="site-header__motion-toggle"
            data-scroll-motion-toggle
            role="switch"
            aria-checked="false"
            aria-label="スクロールアニメーション: オフ（クリックでオン）"
          >
            <span class="site-header__motion-toggle-stack">
              <span class="site-header__motion-switch" aria-hidden="true">
                <span class="site-header__motion-switch-track">
                  <span class="site-header__motion-switch-label site-header__motion-switch-label--on">ON</span>
                  <span class="site-header__motion-switch-label site-header__motion-switch-label--off">OFF</span>
                  <span class="site-header__motion-switch-fill"></span>
                </span>
              </span>
              <span class="site-header__motion-toggle-label" lang="en">animation</span>
            </span>
          </button>
          <script is:inline define:vars={{ scrollMotionKey: 'tenkaisha-scroll-motion' }}>
            (function () {
              function syncMotionToggleFromStorage() {
                try {
                  var on = localStorage.getItem(scrollMotionKey) !== 'off';
                  document.documentElement.setAttribute(
                    'data-scroll-motion',
                    on ? 'on' : 'off',
                  );
                  var btn = document.querySelector('[data-scroll-motion-toggle]');
                  if (!btn) return;
                  btn.setAttribute('aria-checked', String(on));
                  btn.setAttribute(
                    'aria-label',
                    on
                      ? 'スクロールアニメーション: オン（クリックでオフ）'
                      : 'スクロールアニメーション: オフ（クリックでオン）',
                  );
                } catch (e) {}
              }
              syncMotionToggleFromStorage();
              document.addEventListener('astro:before-swap', syncMotionToggleFromStorage);
            })();
          </script>
        </li>
      </ul>
    </nav>
  </div>

  <button
    type="button"
    class="site-header__backdrop"
    aria-label="メニューを閉じる"
    tabindex="-1"
    hidden
    data-site-header-backdrop
  ></button>
</div>

<script>
  import { isSiteNavCurrent } from '../data/site-nav';
  import { stripBasePath } from '../utils/path';
  import { initScrollMotionToggle } from '../scripts/scroll-motion';

  const HOVER_HOLD_CLASS = 'site-header__link--hover-hold';
  /** ポインタが乗っているメニュー（遷移で :hover が外れても見た目を維持する） */
  let heldNavHref: string | null = null;
  /** ClientRouter の入れ替え中は pointerout でホバーを消さない */
  let navSwapSettled = true;
  let snapNavIndicatorToCurrent: (() => void) | null = null;

  function navLinkFromEvent(event: Event): HTMLAnchorElement | null {
    const target = event.target;
    if (!(target instanceof Element)) return null;
    const link = target.closest('a.site-header__link[data-nav-href]');
    return link instanceof HTMLAnchorElement ? link : null;
  }

  function applyHeldNavHover(doc: Document): void {
    if (!heldNavHref) return;
    const nav = doc.getElementById('site-header-nav');
    if (!nav) return;
    nav.querySelectorAll<HTMLAnchorElement>('a.site-header__link[data-nav-href]').forEach((link) => {
      link.classList.toggle(HOVER_HOLD_CLASS, link.dataset.navHref === heldNavHref);
    });
    snapNavIndicatorToCurrent?.();
  }

  function clearHeldNavHover(doc: Document): void {
    heldNavHref = null;
    doc
      .getElementById('site-header-nav')
      ?.querySelectorAll(`.${HOVER_HOLD_CLASS}`)
      .forEach((el) => el.classList.remove(HOVER_HOLD_CLASS));
  }

  function setupSiteHeaderLinkHoverHold(): void {
    if (document.documentElement.hasAttribute('data-header-hover-hold')) return;
    document.documentElement.setAttribute('data-header-hover-hold', '');

    const desktop = () => window.matchMedia('(min-width: 901px)').matches;

    document.addEventListener('pointerover', (event) => {
      if (!desktop()) return;
      const link = navLinkFromEvent(event);
      if (!link?.dataset.navHref) return;
      heldNavHref = link.dataset.navHref;
      applyHeldNavHover(document);
    });

    document.addEventListener('pointerout', (event) => {
      if (!desktop() || !navSwapSettled) return;
      const nav = document.getElementById('site-header-nav');
      if (!nav) return;
      const from = event.target;
      if (!(from instanceof Node) || !nav.contains(from)) return;
      const next = event.relatedTarget;
      if (next instanceof Node && nav.contains(next)) return;
      clearHeldNavHover(document);
    });

    document.addEventListener('astro:before-preparation', () => {
      navSwapSettled = false;
      applyHeldNavHover(document);
    });

    document.addEventListener('astro:before-swap', (event) => {
      const incoming = (event as Event & { newDocument?: Document }).newDocument;
      if (!incoming) return;
      applyHeldNavHover(incoming);
    });

    document.addEventListener('astro:after-swap', () => {
      applyHeldNavHover(document);
    });
  }

  function syncSiteHeaderNavCurrent(): void {
    const path = stripBasePath(window.location.pathname);
    document
      .querySelectorAll<HTMLAnchorElement>(
        '#site-header-nav a.site-header__link[data-nav-href]',
      )
      .forEach((link) => {
      const href = link.dataset.navHref ?? '';
      const isCurrent = isSiteNavCurrent(path, href);
      link.classList.toggle('site-header__link--current', isCurrent);
      if (isCurrent) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function setupSiteHeaderMenu() {
    const root = document.querySelector('.site-header-root');
    const toggle = document.querySelector('[data-site-header-toggle]');
    const nav = document.getElementById('site-header-nav');
    const backdrop = document.querySelector('[data-site-header-backdrop]');
    if (!root || !toggle || !nav || !backdrop || root.hasAttribute('data-nav-bound')) return;
    root.setAttribute('data-nav-bound', '');

    const isMobileNav = () => window.matchMedia('(max-width: 900px)').matches;

    let menuScrollLockY = 0;

    const lockMenuScroll = () => {
      menuScrollLockY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${menuScrollLockY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    };

    const unlockMenuScroll = () => {
      const y = menuScrollLockY;
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      menuScrollLockY = 0;
      window.scrollTo(0, y);
    };

    const setOpen = (open: boolean) => {
      const wasOpen = root.classList.contains('is-nav-open');
      root.classList.toggle('is-nav-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      if (open) {
        backdrop.removeAttribute('hidden');
      } else {
        backdrop.setAttribute('hidden', '');
      }
      if (isMobileNav()) {
        nav.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (open && !wasOpen) lockMenuScroll();
        if (!open && wasOpen) unlockMenuScroll();
      } else {
        nav.removeAttribute('aria-hidden');
        if (!open && wasOpen) unlockMenuScroll();
      }
      document.body.classList.toggle('site-header-nav-open', open);
    };

    setOpen(false);

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!root.classList.contains('is-nav-open'));
    });

    backdrop.addEventListener('click', () => setOpen(false));

    document.addEventListener('click', (event) => {
      if (!root.classList.contains('is-nav-open') || !isMobileNav()) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (nav.contains(target) || toggle.contains(target)) return;
      setOpen(false);
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.classList.contains('is-nav-open')) setOpen(false);
    });

    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  function setupSiteHeaderNavIndicator() {
    const nav = document.getElementById('site-header-nav');
    const list = nav?.querySelector('.site-header__nav-list');
    const indicator = nav?.querySelector('.site-header__nav-indicator');
    if (!nav || !list || !indicator || !(indicator instanceof HTMLElement)) return;

    if (nav.hasAttribute('data-indicator-bound')) {
      snapNavIndicatorToCurrent?.();
      return;
    }
    nav.setAttribute('data-indicator-bound', '');

    const desktopMq = window.matchMedia('(min-width: 901px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const links = () => [...list.querySelectorAll<HTMLAnchorElement>('.site-header__link')];

    let canSlide = false;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;
    const hideDelayMs = 100;

    const forgetHoverPosition = (): void => {
      canSlide = false;
    };

    const cancelScheduledHide = (): void => {
      if (hideTimer === null) return;
      clearTimeout(hideTimer);
      hideTimer = null;
    };

    const hideNow = (): void => {
      cancelScheduledHide();
      forgetHoverPosition();
      indicator.classList.add('is-instant');
      indicator.classList.remove('is-visible');
      requestAnimationFrame(() => indicator.classList.remove('is-instant'));
    };

    const scheduleHide = (): void => {
      cancelScheduledHide();
      if (reducedMotion.matches) {
        forgetHoverPosition();
        hideNow();
        return;
      }
      hideTimer = setTimeout(() => {
        hideTimer = null;
        if (list.querySelector('.site-header__link:hover')) return;
        if (list.querySelector(`.${HOVER_HOLD_CLASS}`)) return;
        forgetHoverPosition();
        hideNow();
      }, hideDelayMs);
    };

    const activeHoverLink = (): HTMLAnchorElement | null =>
      list.querySelector<HTMLAnchorElement>('.site-header__link:hover') ??
      list.querySelector<HTMLAnchorElement>(`.site-header__link.${HOVER_HOLD_CLASS}`);

    const moveTo = (link: HTMLAnchorElement, forceInstant = false): void => {
      if (!desktopMq.matches) return;
      cancelScheduledHide();
      const navRect = nav.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      const instant = forceInstant || !canSlide || reducedMotion.matches;
      if (instant) indicator.classList.add('is-instant');
      indicator.style.left = `${linkRect.left - navRect.left}px`;
      indicator.style.top = `${linkRect.top - navRect.top}px`;
      indicator.style.width = `${linkRect.width}px`;
      indicator.style.height = `${linkRect.height}px`;
      indicator.classList.add('is-visible');
      if (!forceInstant) canSlide = true;
      if (instant) {
        void indicator.offsetWidth;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => indicator.classList.remove('is-instant'));
        });
      }
    };

    links().forEach((link) => {
      link.addEventListener('mouseenter', () => moveTo(link));
      link.addEventListener('mouseleave', () => {
        if (!desktopMq.matches) return;
        requestAnimationFrame(() => {
          if (activeHoverLink()) return;
          scheduleHide();
        });
      });
      link.addEventListener('focus', () => moveTo(link));
    });

    list.addEventListener('mouseleave', scheduleHide);
    nav.addEventListener('mouseleave', (event) => {
      if (!desktopMq.matches) return;
      const next = event.relatedTarget;
      if (next instanceof Node && nav.contains(next)) return;
      scheduleHide();
    });
    nav.addEventListener('focusout', (event) => {
      if (!desktopMq.matches) return;
      const next = event.relatedTarget;
      if (next instanceof Node && nav.contains(next)) return;
      scheduleHide();
    });

    const onLayoutChange = (): void => {
      if (!desktopMq.matches) {
        hideNow();
        return;
      }
      const hovered = activeHoverLink();
      if (hovered) {
        moveTo(hovered, true);
        return;
      }
      hideNow();
    };

    snapNavIndicatorToCurrent = (): void => {
      if (!desktopMq.matches) return;
      const hovered = activeHoverLink();
      if (hovered) {
        moveTo(hovered, true);
        return;
      }
      hideNow();
    };

    window.addEventListener('resize', onLayoutChange);
    desktopMq.addEventListener('change', onLayoutChange);

    snapNavIndicatorToCurrent();
  }

  function setupSiteHeaderScrollProgress() {
    const update = (): void => {
      const bar = document.querySelector('.site-header__scroll-progress-bar');
      const wrap = document.querySelector('.site-header__scroll-progress-wrap');
      const label = document.querySelector('.site-header__scroll-progress-label');
      if (!(bar instanceof HTMLElement) || !(wrap instanceof HTMLElement)) return;
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const maxScroll = Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight,
      );
      const progress = maxScroll > 0 ? Math.min(1, Math.max(0, scrollTop / maxScroll)) : 0;
      const percent = Math.round(progress * 100);
      bar.style.transform = `scaleX(${progress})`;
      wrap.classList.toggle('is-active', percent > 0);
      if (label instanceof HTMLElement) {
        label.textContent =
          percent >= 100 ? 'MAX!' : percent > 0 ? `${percent}%` : '';
        label.style.setProperty('--scroll-label-offset', `${progress * 100}%`);
      }
    };

    if (!document.documentElement.hasAttribute('data-header-scroll-progress')) {
      document.documentElement.setAttribute('data-header-scroll-progress', '');
      window.addEventListener('scroll', update, { passive: true, capture: true });
      window.addEventListener('resize', update, { passive: true });
    }

    update();
  }

  setupSiteHeaderMenu();
  syncSiteHeaderNavCurrent();
  setupSiteHeaderNavIndicator();
  setupSiteHeaderLinkHoverHold();
  setupSiteHeaderScrollProgress();
  initScrollMotionToggle();
  if (!document.documentElement.hasAttribute('data-header-page-load')) {
    document.documentElement.setAttribute('data-header-page-load', '');
    document.addEventListener('astro:page-load', () => {
      setupSiteHeaderMenu();
      syncSiteHeaderNavCurrent();
      setupSiteHeaderNavIndicator();
      setupSiteHeaderLinkHoverHold();
      setupSiteHeaderScrollProgress();
      initScrollMotionToggle();
      applyHeldNavHover(document);
      requestAnimationFrame(() => {
        navSwapSettled = true;
      });
    });
  }
</script>
