---
import { siteHeaderNav, isSiteNavCurrent } from '../data/site-nav';
import { withBase, stripBasePath } from '../utils/path';
import { THEME_USER_CHOICE_ENABLED } from '../scripts/theme';

const navId = 'site-header-nav';
const currentPath = stripBasePath(Astro.url.pathname);
---

<div class="site-header-root">
  <div class="site-header__inner container">
    <div class="site-header__start">
      <a class="site-header__brand" href={withBase('/')} aria-label="転回社 トップへ">
        <span class="site-header__logo">転回社</span>
      </a>
      <div class="site-header__scroll-progress-wrap">
        <span class="site-header__scroll-progress" aria-hidden="true">
          <span class="site-header__scroll-progress-bar"></span>
        </span>
        <span class="site-header__scroll-progress-label" aria-hidden="true"></span>
      </div>
    </div>

    <button
      type="button"
      class="site-header__menu-toggle"
      aria-expanded="false"
      aria-controls={navId}
      aria-label="メニューを開く"
      data-site-header-toggle
    >
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <nav class="site-header__nav" id={navId} aria-label="サイト内メニュー">
      <span class="site-header__nav-indicator" aria-hidden="true"></span>
      <ul class="site-header__nav-list">
        {
          THEME_USER_CHOICE_ENABLED ? (
            <li class="site-header__nav-item site-header__nav-item--theme">
              <button
                type="button"
                class="site-header__theme-toggle"
                aria-label="ダークモードに切り替え"
                aria-pressed="false"
                data-theme-toggle
              >
                <i
                  class="fa-solid fa-moon site-header__theme-icon site-header__theme-icon--moon"
                  aria-hidden="true"
                />
                <i
                  class="fa-solid fa-sun site-header__theme-icon site-header__theme-icon--sun"
                  aria-hidden="true"
                />
                <span class="sr-only">表示モード切替</span>
              </button>
            </li>
          ) : null
        }
        {
          siteHeaderNav.map((item) => {
            const isCurrent = isSiteNavCurrent(currentPath, item.href);
            return (
            <li class="site-header__nav-item">
              <a
                class:list={['site-header__link', isCurrent && 'site-header__link--current']}
                href={withBase(item.href)}
                data-nav-href={item.href}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
            );
          })
        }
      </ul>
    </nav>
  </div>

  <button
    type="button"
    class="site-header__backdrop"
    aria-label="メニューを閉じる"
    tabindex="-1"
    hidden
    data-site-header-backdrop
  ></button>
</div>

<script>
  import { isSiteNavCurrent } from '../data/site-nav';
  import { stripBasePath } from '../utils/path';

  let snapNavIndicatorToCurrent: (() => void) | null = null;

  function syncSiteHeaderNavCurrent(): void {
    const nav = document.getElementById('site-header-nav');
    if (!nav) return;
    const path = stripBasePath(window.location.pathname);
    nav.querySelectorAll<HTMLAnchorElement>('.site-header__link[data-nav-href]').forEach((link) => {
      const href = link.dataset.navHref ?? '';
      const isCurrent = isSiteNavCurrent(path, href);
      link.classList.toggle('site-header__link--current', isCurrent);
      if (isCurrent) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function setupSiteHeaderMenu() {
    const root = document.querySelector('.site-header-root');
    const toggle = document.querySelector('[data-site-header-toggle]');
    const nav = document.getElementById('site-header-nav');
    const backdrop = document.querySelector('[data-site-header-backdrop]');
    if (!root || !toggle || !nav || !backdrop || root.hasAttribute('data-nav-bound')) return;
    root.setAttribute('data-nav-bound', '');

    const isMobileNav = () => window.matchMedia('(max-width: 900px)').matches;

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-nav-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      if (open) {
        backdrop.removeAttribute('hidden');
      } else {
        backdrop.setAttribute('hidden', '');
      }
      if (isMobileNav()) {
        nav.setAttribute('aria-hidden', open ? 'false' : 'true');
      } else {
        nav.removeAttribute('aria-hidden');
      }
      document.body.classList.toggle('site-header-nav-open', open);
    };

    setOpen(false);

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!root.classList.contains('is-nav-open'));
    });

    backdrop.addEventListener('click', () => setOpen(false));

    document.addEventListener('click', (event) => {
      if (!root.classList.contains('is-nav-open') || !isMobileNav()) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (nav.contains(target) || toggle.contains(target)) return;
      setOpen(false);
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.classList.contains('is-nav-open')) setOpen(false);
    });

    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  function setupSiteHeaderNavIndicator() {
    const nav = document.getElementById('site-header-nav');
    const list = nav?.querySelector('.site-header__nav-list');
    const indicator = nav?.querySelector('.site-header__nav-indicator');
    if (!nav || !list || !indicator || !(indicator instanceof HTMLElement)) return;

    const getCurrentLink = (): HTMLAnchorElement | null =>
      list.querySelector<HTMLAnchorElement>('.site-header__link[aria-current="page"]');

    if (nav.hasAttribute('data-indicator-bound')) {
      snapNavIndicatorToCurrent?.();
      return;
    }
    nav.setAttribute('data-indicator-bound', '');

    const desktopMq = window.matchMedia('(min-width: 901px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const links = () => [...list.querySelectorAll<HTMLAnchorElement>('.site-header__link')];

    let activeLink: HTMLAnchorElement | null = null;
    let canSlide = false;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;
    const hideDelayMs = 100;

    const cancelScheduledHide = (): void => {
      if (hideTimer === null) return;
      clearTimeout(hideTimer);
      hideTimer = null;
    };

    const hideNow = (): void => {
      cancelScheduledHide();
      activeLink = null;
      indicator.classList.add('is-instant');
      indicator.classList.remove('is-visible');
      requestAnimationFrame(() => indicator.classList.remove('is-instant'));
    };

    const restoreCurrentOrHide = (): void => {
      if (!desktopMq.matches) {
        hideNow();
        return;
      }
      const current = getCurrentLink();
      if (current) {
        moveTo(current, false);
        return;
      }
      hideNow();
    };

    const scheduleHide = (): void => {
      cancelScheduledHide();
      if (reducedMotion.matches) {
        restoreCurrentOrHide();
        return;
      }
      hideTimer = setTimeout(() => {
        hideTimer = null;
        if (list.querySelector('.site-header__link:hover')) return;
        restoreCurrentOrHide();
      }, hideDelayMs);
    };

    const moveTo = (link: HTMLAnchorElement, forceInstant = false): void => {
      if (!desktopMq.matches) return;
      cancelScheduledHide();
      activeLink = link;
      const navRect = nav.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      const instant = forceInstant || !canSlide || reducedMotion.matches;
      if (instant) indicator.classList.add('is-instant');
      indicator.style.left = `${linkRect.left - navRect.left}px`;
      indicator.style.top = `${linkRect.top - navRect.top}px`;
      indicator.style.width = `${linkRect.width}px`;
      indicator.style.height = `${linkRect.height}px`;
      indicator.classList.add('is-visible');
      if (!forceInstant) canSlide = true;
      if (instant) {
        void indicator.offsetWidth;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => indicator.classList.remove('is-instant'));
        });
      }
    };

    links().forEach((link) => {
      link.addEventListener('mouseenter', () => moveTo(link));
      link.addEventListener('mouseleave', () => {
        if (!desktopMq.matches) return;
        requestAnimationFrame(() => {
          if (list.querySelector('.site-header__link:hover')) return;
          scheduleHide();
        });
      });
      link.addEventListener('focus', () => moveTo(link));
    });

    list.addEventListener('mouseleave', scheduleHide);
    nav.addEventListener('mouseleave', (event) => {
      if (!desktopMq.matches) return;
      const next = event.relatedTarget;
      if (next instanceof Node && nav.contains(next)) return;
      scheduleHide();
    });
    nav.addEventListener('focusout', (event) => {
      if (!desktopMq.matches) return;
      const next = event.relatedTarget;
      if (next instanceof Node && nav.contains(next)) return;
      scheduleHide();
    });

    const onLayoutChange = (): void => {
      if (!desktopMq.matches) {
        hideNow();
        return;
      }
      const hovered = list.querySelector<HTMLAnchorElement>('.site-header__link:hover');
      if (hovered) {
        moveTo(hovered, true);
        return;
      }
      if (activeLink) {
        moveTo(activeLink, true);
        return;
      }
      restoreCurrentOrHide();
    };

    snapNavIndicatorToCurrent = (): void => {
      if (!desktopMq.matches) return;
      const hovered = list.querySelector<HTMLAnchorElement>('.site-header__link:hover');
      if (hovered) {
        moveTo(hovered, true);
        return;
      }
      const current = getCurrentLink();
      if (current) moveTo(current, true);
      else hideNow();
    };

    window.addEventListener('resize', onLayoutChange);
    desktopMq.addEventListener('change', onLayoutChange);

    snapNavIndicatorToCurrent();
  }

  function setupSiteHeaderScrollProgress() {
    const update = (): void => {
      const bar = document.querySelector('.site-header__scroll-progress-bar');
      const wrap = document.querySelector('.site-header__scroll-progress-wrap');
      const label = document.querySelector('.site-header__scroll-progress-label');
      if (!(bar instanceof HTMLElement) || !(wrap instanceof HTMLElement)) return;
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const maxScroll = Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight,
      );
      const progress = maxScroll > 0 ? Math.min(1, Math.max(0, scrollTop / maxScroll)) : 0;
      const percent = Math.round(progress * 100);
      bar.style.width = `${progress * 100}%`;
      wrap.classList.toggle('is-active', percent > 0);
      if (label instanceof HTMLElement) {
        label.textContent = percent > 0 ? `${percent}%` : '';
        label.style.setProperty('--scroll-label-offset', `${progress * 100}%`);
      }
    };

    if (!document.documentElement.hasAttribute('data-header-scroll-progress')) {
      document.documentElement.setAttribute('data-header-scroll-progress', '');
      window.addEventListener('scroll', update, { passive: true, capture: true });
      window.addEventListener('resize', update, { passive: true });
    }

    update();
  }

  setupSiteHeaderMenu();
  syncSiteHeaderNavCurrent();
  setupSiteHeaderNavIndicator();
  setupSiteHeaderScrollProgress();
  document.addEventListener('astro:page-load', () => {
    setupSiteHeaderMenu();
    syncSiteHeaderNavCurrent();
    setupSiteHeaderNavIndicator();
    setupSiteHeaderScrollProgress();
  });
</script>
