---
import { siteHeaderNav } from '../data/site-nav';
import { withBase } from '../utils/path';

const navId = 'site-header-nav';
---

<div class="site-header-root">
  <div class="site-header__inner container">
    <a class="site-header__brand" href={withBase('/')} aria-label="転回社 トップへ">
      <span class="site-header__logo">転回社</span>
    </a>

    <button
      type="button"
      class="site-header__menu-toggle"
      aria-expanded="false"
      aria-controls={navId}
      aria-label="メニューを開く"
      data-site-header-toggle
    >
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <nav class="site-header__nav" id={navId} aria-label="サイト内メニュー">
      <ul class="site-header__nav-list">
        {
          siteHeaderNav.map((item) => (
            <li class="site-header__nav-item">
              <a class="site-header__link" href={withBase(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <button
    type="button"
    class="site-header__backdrop"
    aria-label="メニューを閉じる"
    tabindex="-1"
    hidden
    data-site-header-backdrop
  ></button>
</div>

<script>
  function setupSiteHeaderMenu() {
    const root = document.querySelector('.site-header-root');
    const toggle = document.querySelector('[data-site-header-toggle]');
    const nav = document.getElementById('site-header-nav');
    const backdrop = document.querySelector('[data-site-header-backdrop]');
    if (!root || !toggle || !nav || !backdrop || root.hasAttribute('data-nav-bound')) return;
    root.setAttribute('data-nav-bound', '');

    const isMobileNav = () => window.matchMedia('(max-width: 900px)').matches;

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-nav-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      if (open) {
        backdrop.removeAttribute('hidden');
      } else {
        backdrop.setAttribute('hidden', '');
      }
      if (isMobileNav()) {
        nav.setAttribute('aria-hidden', open ? 'false' : 'true');
      } else {
        nav.removeAttribute('aria-hidden');
      }
      document.body.classList.toggle('site-header-nav-open', open);
    };

    setOpen(false);

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!root.classList.contains('is-nav-open'));
    });

    backdrop.addEventListener('click', () => setOpen(false));

    document.addEventListener('click', (event) => {
      if (!root.classList.contains('is-nav-open') || !isMobileNav()) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (nav.contains(target) || toggle.contains(target)) return;
      setOpen(false);
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.classList.contains('is-nav-open')) setOpen(false);
    });

    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  setupSiteHeaderMenu();
  document.addEventListener('astro:page-load', setupSiteHeaderMenu);
</script>
