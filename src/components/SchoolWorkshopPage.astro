---
import {
  schoolWorkshopAboutPoints,
  schoolWorkshopPamphletHistory,
} from '../data/school-workshop-page';
import SchoolWorkshopFlow from './SchoolWorkshopFlow.astro';
import SchoolWorkshopTeacherQuotes from './SchoolWorkshopTeacherQuotes.astro';
import SchoolWorkshopActivityExamples from './SchoolWorkshopActivityExamples.astro';
---

<section class="ws-page" aria-label="演劇ワークショップのご案内">
  <h2>演劇ワークショップについて</h2>
  <div class="ws-page__about">
    {
      schoolWorkshopAboutPoints.map((point) => (
        <article class="ws-page__about-card">
          <h3>{point.title}</h3>
          <p>{point.body}</p>
        </article>
      ))
    }
  </div>

  <SchoolWorkshopFlow />

  <SchoolWorkshopActivityExamples />

  <SchoolWorkshopTeacherQuotes />

  <h2>過去の活動実績</h2>
  <p class="ws-page__history-lead">
    パンフレット掲載の2014年度〜2020年度の主な実施校です（2021年度以降も継続して実施しています）。
  </p>
  <div class="ws-page__history-scroll">
    <div class="ws-page__history">
      {
        schoolWorkshopPamphletHistory.map((yearRow) => (
          <section class="ws-page__history-year">
            <h3 class="ws-page__history-year-title">{yearRow.year}年度</h3>
            {
              yearRow.blocks.map((block) => (
                <div class="ws-page__history-block">
                  <p class="ws-page__history-sponsor">○{block.sponsor}</p>
                  <p class="ws-page__history-program">{block.program}</p>
                  <ul class="ws-page__history-schools">
                    {block.entries.map((entry) => (
                      <li>{entry}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </section>
        ))
      }
    </div>
  </div>
</section>
