---
import {
  schoolWorkshopSummary,
  schoolWorkshopYearStats,
} from '../data/school-workshop-stats';

const yearRowsChronological = schoolWorkshopYearStats.toSorted(
  (a, b) => a.year - b.year,
);
const maxSessions = Math.max(...schoolWorkshopYearStats.map((row) => row.sessions));
const yMax = Math.ceil(maxSessions / 5) * 5;
const yTickStep = 5;
const yTicks = Array.from({ length: yMax / yTickStep + 1 }, (_, i) => i * yTickStep);
---

<section class="ws-stats" aria-labelledby="ws-stats-title">
  <h2 id="ws-stats-title">年度別の実施件数</h2>

  <dl class="ws-stats__highlights">
    <div>
      <dt>累計実施</dt>
      <dd class="ws-stats__value">
        <span class="ws-stats__num">{schoolWorkshopSummary.totalSessions}</span>
        <span class="ws-stats__unit">件</span>
      </dd>
    </div>
  </dl>

  <figure class="ws-stats__chart" aria-labelledby="ws-stats-title">
    <div class="ws-stats__vchart" style={`--ws-y-max: ${yMax}`}>
      <p class="ws-stats__vchart-y-label">件</p>
      <div class="ws-stats__vchart-body">
        <div class="ws-stats__vchart-y-axis" aria-hidden="true">
          {
            [...yTicks].reverse().map((tick) => (
              <span class="ws-stats__vchart-y-tick">{tick}</span>
            ))
          }
        </div>
        <div class="ws-stats__vchart-plot">
          <div class="ws-stats__vchart-grid" aria-hidden="true">
            {
              yTicks.map((tick) => (
                <span
                  class="ws-stats__vchart-grid-line"
                  style={`--ws-grid-y: ${tick / yMax}`}
                />
              ))
            }
          </div>
          <div class="ws-stats__vchart-columns">
            {
              yearRowsChronological.map((row) => (
                <div class="ws-stats__bar-col">
                  <div
                    class="ws-stats__bar-track"
                    style={`--ws-bar-ratio: ${row.sessions / yMax}`}
                  >
                    <span class="ws-stats__bar-value">{row.sessions}</span>
                    <span
                      class:list={[
                        'ws-stats__bar-fill',
                        row.planned && 'ws-stats__bar-fill--planned',
                      ]}
                      title={`${row.year}年度 ${row.sessions}件${row.planned ? '（予定含む）' : ''}`}
                    />
                  </div>
                </div>
              ))
            }
          </div>
          <div class="ws-stats__vchart-x-ticks" aria-hidden="true">
            {
              yearRowsChronological.map((row) => (
                <span class="ws-stats__bar-label">
                  <span class="ws-stats__bar-year">{row.year}</span>
                  {row.planned ? (
                    <span class="ws-stats__bar-planned-mark">予定含む</span>
                  ) : null}
                </span>
              ))
            }
          </div>
        </div>
      </div>
      <p class="ws-stats__vchart-x-label">年度</p>
    </div>
    <figcaption class="sr-only">
      横軸を年度、縦軸を実施件数とした棒グラフ。目盛りは0から{yMax}件まで{yTickStep}件刻みです。
    </figcaption>
  </figure>
</section>
