---
import Card from './Card.astro';
import { getCollection } from 'astro:content';
import { eventEntryCardProps, partitionEventList } from '../utils/event-content';

interface Props {
  /** 詳細ページ右カラム。一覧では `below` */
  placement?: 'side' | 'below';
}

const { placement = 'side' } = Astro.props;

const { currentPerformances, currentEvents } = partitionEventList(await getCollection('stages'));
const hasCurrent = currentPerformances.length > 0 || currentEvents.length > 0;
---

<aside
  class:list={[
    'news-sidebar',
    placement === 'side' && 'news-layout__side',
    placement === 'below' && 'news-sidebar--below',
  ]}
  aria-labelledby="news-sidebar-heading"
>
  <h2 id="news-sidebar-heading" class="news-sidebar__heading">公演情報</h2>
  {
    !hasCurrent ? (
      <p class="news-sidebar__empty">現在、公演・イベントの情報はありません。</p>
    ) : (
      <div class="news-sidebar__cards">
        {currentPerformances.map((p) => (
          <Card
            layout="sidebar"
            href={`/stages/${p.id}/`}
            image={p.data.cover}
            title={p.data.title}
            {...eventEntryCardProps(p.data)}
          />
        ))}
        {currentEvents.map((e) => (
          <Card
            layout="sidebar"
            href={`/stages/${e.id}/`}
            image={e.data.cover}
            title={e.data.title}
            {...eventEntryCardProps(e.data)}
          />
        ))}
      </div>
    )
  }
</aside>
