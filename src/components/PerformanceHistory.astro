---
import {
  groupPerformanceHistoryByYear,
  type PerformanceHistoryItem,
} from '../utils/performance-history';

interface Props {
  items: PerformanceHistoryItem[];
  resolveLink?: (item: PerformanceHistoryItem) => string | undefined;
  includeTime?: boolean;
}

const { items, resolveLink, includeTime = false } = Astro.props;

const yearGroups = groupPerformanceHistoryByYear(items, resolveLink, { includeTime });
---

<section class="perf-history" aria-label="上演履歴">
  <h2 class="perf-history__title">上演履歴</h2>
  <div class="perf-history__groups">
    <div class="perf-history__rail">
      {
        yearGroups.map((group) => (
          <section class="perf-history__group" aria-label={`${group.year}年`}>
            <h3 class="perf-history__year">{group.year}年</h3>
            <ol class="perf-history__list">
              {
                group.items.map((item) => (
                  <li class="perf-history__item">
                    {
                      item.parts ? (
                        <span class="perf-history__date">
                          {
                            item.parts.map((part) =>
                              part.href ? (
                                <a
                                  class="perf-history__date perf-history__date--link"
                                  href={part.href}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  {part.text}
                                </a>
                              ) : (
                                part.text
                              ),
                            )
                          }
                        </span>
                      ) : item.href ? (
                        <a
                          class="perf-history__date perf-history__date--link"
                          href={item.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {item.label}
                        </a>
                      ) : (
                        <span class="perf-history__date">{item.label}</span>
                      )
                    }
                  </li>
                ))
              }
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</section>
