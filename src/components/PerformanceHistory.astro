---
import {
  groupPerformanceHistoryByYear,
  type PerformanceHistoryItem,
} from '../utils/performance-history';

interface Props {
  items: PerformanceHistoryItem[];
}

const { items } = Astro.props;

const yearGroups = groupPerformanceHistoryByYear(items);
---

<section class="perf-history" aria-label="上演履歴">
  <h2 class="perf-history__title">上演履歴</h2>
  <div class="perf-history__groups">
    <div class="perf-history__rail">
      {
        yearGroups.map((group) => (
          <section class="perf-history__group" aria-label={`${group.year}年`}>
            <h3 class="perf-history__year">{group.year}年</h3>
            <ol class="perf-history__list">
              {
                group.items.map((item) => (
                  <li class="perf-history__item">
                    <span class="perf-history__date">{item.label}</span>
                  </li>
                ))
              }
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</section>
