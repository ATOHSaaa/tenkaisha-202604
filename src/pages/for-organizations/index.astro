---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import { organizationPrograms } from '../../data/site';
---

<Base title="法人の方へ" description="企業・自治体向けの演劇ワークショップのご案内。">
  <PageHeader
    jp="法人の方へ"
    lead="企業・自治体・学校など、法人・団体向けの演劇プログラムをご用意しています。"
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        {
          organizationPrograms.map((p) => (
            <Card href={p.path} title={p.name} body={p.summary} />
          ))
        }
      </div>
    </div>
  </section>
</Base>
