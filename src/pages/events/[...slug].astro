---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PerformanceArticle from '../../components/PerformanceArticle.astro';
import { getEntry, render } from 'astro:content';
import { isPerformanceEntry } from '../../utils/event-content';
import { formatShowTitle } from '../../utils/titles';

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

if (!slug) {
  return Astro.redirect('/404');
}

const entry = await getEntry('events', slug);

if (!entry) {
  return Astro.redirect('/404');
}

const showTitle = formatShowTitle(entry.data.title);
const isPerformance = isPerformanceEntry(entry);

let EventContent: Awaited<ReturnType<typeof render>>['Content'] | null = null;
if (!isPerformance) {
  ({ Content: EventContent } = await render(entry));
}
---

{
  isPerformance ? (
    <Base title={showTitle} scrollReveal={false}>
      <PerformanceArticle entry={entry} />
    </Base>
  ) : (
    <Base title={showTitle} scrollReveal={false}>
      <article class="event">
        <PageHeader jp={showTitle} compact />

        <section class="container event__body">
          <div class="event__grid">
            <div class="prose">{EventContent && <EventContent />}</div>
            {
              entry.data.cover && (
                <aside class="event__side">
                  <img class="event__cover" src={entry.data.cover} alt="" />
                </aside>
              )
            }
          </div>
        </section>
      </article>
    </Base>
  )
}
