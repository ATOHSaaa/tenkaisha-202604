---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import RequestDetail from '../../components/RequestDetail.astro';
import SchoolWorkshopStats from '../../components/SchoolWorkshopStats.astro';
import {
  workshopCasebookCover,
  workshopCasebookPath,
} from '../../data/workshop-casebook';
import { withBase } from '../../utils/path';

const casebookHref = withBase(workshopCasebookPath);

const info = {
  slug: 'school-workshop',
  name: '演劇ワークショップ',
  english: 'SCHOOL WORKSHOP',
  summary: '小・中学校向けの演劇ワークショップを、学校のご要望に合わせて設計・実施します。',
  image: '/images/education/workshop-program.jpg',
  path: '/education/workshop/',
};

const introLead = [
  '転回社では、主に小学校〜高校向けの演劇ワークショップを行っています。',
  '過去10年にわたるワークショップ活動を元に、事例をピックアップして紹介した冊子も制作しております。お問い合わせいただければ、冊子をお送りすることも可能です。',
  '生徒・児童の状況、申請を検討している文化庁の学校向け事業などに合わせて提案が可能ですので、まずはご連絡ください。',
];
---

<Base title={info.name} description={info.summary}>
  <PageHeader jp={info.name} compact />

  <RequestDetail
    info={info}
    description=""
    showHero={false}
    showSidebar={false}
  >
    <div slot="before-contact" class="ws-page-stack">
      <div class="ws-intro">
        <div class="ws-intro__lead-panel">
          <div class="ws-intro__prose">
            {introLead.map((text) => <p>{text}</p>)}
          </div>
        </div>
        <a class="ws-intro__cover-link" href={casebookHref}>
          <figure class="ws-intro__cover">
            <img
              src={withBase(workshopCasebookCover)}
              alt="演劇ワークショップ 事例集の表紙"
              width={724}
              height={1024}
              loading="lazy"
            />
            <figcaption class="ws-intro__cover-caption">
              演劇ワークショップ 事例集<span class="ws-intro__cover-hint">（内容を見る）</span>
            </figcaption>
          </figure>
        </a>
      </div>
      <SchoolWorkshopStats />
    </div>
  </RequestDetail>
</Base>
