---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import RequestDetail from '../../components/RequestDetail.astro';
import SchoolWorkshopPage from '../../components/SchoolWorkshopPage.astro';
import SchoolWorkshopStats from '../../components/SchoolWorkshopStats.astro';

const info = {
  slug: 'school-workshop',
  name: '演劇ワークショップ',
  english: 'SCHOOL WORKSHOP',
  summary: '小・中学校向けの演劇ワークショップを、学校のご要望に合わせて設計・実施します。',
  image: '/images/mocks/request-workshop.svg',
  path: '/education/workshop/',
};
---

<Base title={info.name} description={info.summary}>
  <PageHeader jp={info.name} compact />

  <RequestDetail
    info={info}
    description=""
    backHref="/education/"
    backLabel="演劇と教育へ戻る"
    showHero={false}
    showSidebar={false}
  >
    <div slot="before-contact" class="ws-page-stack">
      <SchoolWorkshopPage />
      <SchoolWorkshopStats />
    </div>
  </RequestDetail>
</Base>
