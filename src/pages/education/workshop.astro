---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import RequestDetail from '../../components/RequestDetail.astro';
import SchoolWorkshopStats from '../../components/SchoolWorkshopStats.astro';
import SchoolWorkshopAbout from '../../components/SchoolWorkshopAbout.astro';
import SchoolWorkshopFlow from '../../components/SchoolWorkshopFlow.astro';
import SchoolWorkshopTeacherQuotes from '../../components/SchoolWorkshopTeacherQuotes.astro';
import SchoolWorkshopActivityExamples from '../../components/SchoolWorkshopActivityExamples.astro';
import {
  workshopCasebookCover,
  workshopCasebookPath,
} from '../../data/workshop-casebook';
import { schoolWorkshopCopy } from '../../data/school-workshop-copy';
import { withBase } from '../../utils/path';

const casebookHref = withBase(workshopCasebookPath);
const { workshopPage } = schoolWorkshopCopy;

const info = {
  slug: 'school-workshop',
  name: '演劇ワークショップ',
  english: 'SCHOOL WORKSHOP',
  summary: '小・中学校向けの演劇ワークショップを、学校のご要望に合わせて設計・実施します。',
  image: '/images/education/workshop-program.jpg',
  path: '/education/workshop/',
};

const introLead = workshopPage.intro;
---

<Base title={info.name} description={info.summary}>
  <PageHeader jp={info.name} compact />

  <RequestDetail
    info={info}
    description=""
    showHero={false}
    showSidebar={false}
  >
    <div slot="before-contact" class="ws-page-stack">
      <div class="ws-page-stack__with-sidebar">
        <div class="ws-page-stack__lead ws-intro__lead-panel">
          <div class="ws-intro__prose">
            {introLead.map((text) => <p>{text}</p>)}
          </div>
        </div>

        <aside class="ws-page-stack__sidebar">
          <p class="ws-intro__cover-tag">＼5つの事例を掲載／</p>
          <figure class="ws-intro__cover">
            <a class="ws-intro__cover-link" href={casebookHref}>
              <img
                src={withBase(workshopCasebookCover)}
                alt="演劇ワークショップ事例集の表紙"
                width={724}
                height={1024}
                loading="lazy"
                decoding="async"
              />
            </a>
            <figcaption class="ws-intro__cover-caption">
              『演劇ワークショップ事例集』
            </figcaption>
          </figure>
          <p class="ws-intro__casebook-more-wrap">
            <a class="ws-intro__casebook-more" href={casebookHref}>詳細を見る →</a>
          </p>
        </aside>

        <div class="ws-page-stack__about-slot">
          <SchoolWorkshopAbout />
        </div>

        <div class="ws-page-stack__flow-slot">
          <SchoolWorkshopFlow />
          <SchoolWorkshopActivityExamples />
          <SchoolWorkshopTeacherQuotes />
        </div>

        <div class="ws-page-stack__stats-slot">
          <SchoolWorkshopStats />
        </div>
      </div>
    </div>
  </RequestDetail>
</Base>
