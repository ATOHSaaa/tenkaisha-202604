---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import RequestDetail from '../../components/RequestDetail.astro';
import SchoolPerformanceRepertoire from '../../components/SchoolPerformanceRepertoire.astro';

const info = {
  slug: 'school',
  name: '学校公演',
  english: 'SCHOOL SHOW',
  summary: '熊本を中心に、小学校〜高校向けの学校公演を承ります。',
  image: '/images/education/school-performance.png',
  path: '/education/school/',
};

const introLead = [
  '熊本を中心に、主に小学校〜高校を対象とした学校公演を承ります。体育館・多目的室での上演にも対応可能で、公演後に児童・生徒と交流する時間も\u200b設けられます。',
  'お問い合わせいただくと、児童・生徒の状況や採択事業などに合わせた上演プランをご提案いたします。',
];
---

<Base title={info.name} description={info.summary}>
  <PageHeader jp={info.name} compact introPanel leadParagraphs={introLead}>
    <p slot="eyecatch">
      地域<span class="page-header__eyecatch-hira">に</span>演劇<span class="page-header__eyecatch-hira">を</span>
    </p>
  </PageHeader>

  <RequestDetail
    info={info}
    description=""
    showHero={false}
    showSidebar={false}
  >
    <SchoolPerformanceRepertoire slot="before-contact" />
  </RequestDetail>
</Base>
