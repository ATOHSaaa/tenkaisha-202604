---
import NotFoundPage from '../../../components/NotFoundPage.astro';
import Base from '../../../layouts/Base.astro';
import PageContactCta from '../../../components/PageContactCta.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SchoolPiecePamphlet from '../../../components/SchoolPiecePamphlet.astro';
import SchoolPieceSourceCredit from '../../../components/SchoolPieceSourceCredit.astro';
import SchoolTargetPills from '../../../components/SchoolTargetPills.astro';
import { getSchoolPieceExtra } from '../../../data/school-piece-content';
import { schoolPerformanceRepertoire } from '../../../data/school-performance-repertoire';
import { getSchoolPerformancePiece } from '../../../utils/school-performance-repertoire';
import { withBase } from '../../../utils/path';

export async function getStaticPaths() {
  return schoolPerformanceRepertoire.map((piece) => ({
    params: { slug: piece.slug },
  }));
}

export const prerender = true;

const slug = Astro.params.slug ?? '';
const piece = slug ? getSchoolPerformancePiece(slug) : undefined;
const extra = slug ? getSchoolPieceExtra(slug) : undefined;
const notFound = !piece;

if (notFound) {
  Astro.response.status = 404;
}

const synopsis = extra?.synopsis ?? piece?.lead ?? '';
const pageTitle = piece ? `${piece.work}｜学校公演` : '学校公演';
---

{
  notFound ? (
    <NotFoundPage />
  ) : (
    <Base title={pageTitle} description={synopsis}>
      <PageHeader jp={piece!.work} supertitle={piece!.overview} compact>
        <div class="school-piece__header-row">
          <dl class="school-piece__meta school-piece__meta--header">
            <div>
              <dt>対象</dt>
              <dd>
                <SchoolTargetPills targets={piece!.targets} />
              </dd>
            </div>
            <div>
              <dt>公演時間</dt>
              <dd>{piece!.duration}</dd>
            </div>
          </dl>
          <div class="school-piece__synopsis-block">
            {extra?.sourceCredit ? <SchoolPieceSourceCredit credit={extra.sourceCredit} /> : null}
            <p class="page-header__lead school-piece__synopsis">{synopsis}</p>
          </div>
        </div>
      </PageHeader>

      <section class:list={['container', 'school-piece', extra?.pamphlet && 'school-piece--pamphlet']}>
        {extra?.pamphlet ? <SchoolPiecePamphlet pamphlet={extra.pamphlet} /> : null}

        <PageContactCta body="学校公演のご依頼・ご相談は、お問い合わせフォームよりお気軽にご連絡ください。学年・会場・時間に合わせた構成もご相談いただけます。" />

        <p class="school-piece__back">
          <a class="link-arrow" href={withBase('/education/school/')}>← 学校公演・演目一覧へ</a>
        </p>
      </section>
    </Base>
  )
}
