---
import NotFoundPage from '../../../components/NotFoundPage.astro';
import Base from '../../../layouts/Base.astro';
import PageContactCta from '../../../components/PageContactCta.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SchoolPieceBriefSpec from '../../../components/SchoolPieceBriefSpec.astro';
import SchoolPiecePamphlet from '../../../components/SchoolPiecePamphlet.astro';
import SchoolPieceSourceCredit from '../../../components/SchoolPieceSourceCredit.astro';
import {
  getSchoolEntries,
  getSchoolEntry,
  resolveSchoolPamphlet,
  resolveSchoolSlug,
  schoolEntrySynopsis,
} from '../../../utils/school-content';
import { withBase } from '../../../utils/path';

export async function getStaticPaths() {
  const entries = await getSchoolEntries();
  return entries.filter((entry) => entry.data.page).map((entry) => ({
    params: { slug: entry.id },
  }));
}

export const prerender = true;

const rawSlug = Astro.params.slug ?? '';
const slug = rawSlug ? resolveSchoolSlug(rawSlug) : '';
const entry = slug ? await getSchoolEntry(slug) : undefined;
const notFound = !entry || !entry.data.page;

if (notFound) {
  Astro.response.status = 404;
}

const data = entry?.data;
const synopsis = entry ? schoolEntrySynopsis(entry) : '';
const pamphlet = data?.pamphlet
  ? resolveSchoolPamphlet(data.pamphlet, { duration: data.duration })
  : undefined;
const pageTitle = data ? `${data.work}｜学校公演` : '学校公演';
---

{
  notFound ? (
    <NotFoundPage />
  ) : (
    <Base title={pageTitle} description={synopsis}>
      <PageHeader jp={data!.work} supertitle={data!.overview} compact>
        <div class="school-piece__header-row">
          <div class="school-piece__synopsis-block">
            {data!.sourceCredit ? <SchoolPieceSourceCredit credit={data!.sourceCredit} /> : null}
            <p class="page-header__lead school-piece__synopsis" lang="ja">{synopsis}</p>
          </div>
        </div>
      </PageHeader>

      <section class:list={['container', 'school-piece', pamphlet && 'school-piece--pamphlet']}>
        {
          pamphlet ? (
            <SchoolPiecePamphlet pamphlet={pamphlet} targets={data!.targets} />
          ) : (
            <SchoolPieceBriefSpec targets={data!.targets} duration={data!.duration} />
          )
        }

        <PageContactCta placement="school" />
      </section>
    </Base>
  )
}
