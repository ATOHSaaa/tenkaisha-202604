---
import Base from '../../layouts/Base.astro';
import RequestDetail from '../../components/RequestDetail.astro';
import { requests } from '../../data/site';

const info = requests.find((r) => r.slug === 'workshop')!;
---

<Base title={info.name}>
  <RequestDetail
    info={info}
    description="演劇の手法を使ったワークショップを、学校・公民館・企業・地域団体向けに承ります。年齢・テーマ・時間にあわせてカスタマイズした内容をご提案します。"
    points={[
      '1時間の単発〜複数日の連続型まで柔軟に対応',
      '小学校低学年〜高齢者向けまで、幅広い年齢層に対応',
      '発声・即興・創作など、メニューは目的に応じて設計',
      '過去実績：小・中・高等学校、公民館、福祉施設、企業研修 など',
    ]}
  />
</Base>
