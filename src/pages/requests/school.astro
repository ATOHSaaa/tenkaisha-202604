---
import Base from '../../layouts/Base.astro';
import RequestDetail from '../../components/RequestDetail.astro';
import { requests } from '../../data/site';

const info = requests.find((r) => r.slug === 'school')!;
---

<Base title={info.name}>
  <RequestDetail
    info={info}
    description="熊本を中心に、主に小学校を対象とした学校公演を承ります。体育館・多目的室での上演にも対応可能で、公演後に児童・生徒と交流する時間も設けられます。"
    points={[
      '体育館・多目的室での上演に対応',
      '題材・時間・内容のカスタマイズ可',
      '公演後の交流・ワークショップも対応可能',
      '熊本県内での実績多数',
    ]}
  />
</Base>
