---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import { requests } from '../../data/site';
---

<Base title="依頼窓口" description="転回社への各種ご依頼・ご相談の窓口です。学校公演、ワークショップ、劇団員への出演依頼など。">
  <PageHeader jp="依頼窓口" lead="学校公演、ワークショップ、劇団員へのご依頼はこちらから。" />

  <section class="requests">
    <div class="container">
      <div class="grid grid--3">
        {
          requests.map((r) => (
            <Card
              href={r.path}
              image={r.image}
              label={r.english}
              title={r.name}
              body={r.summary}
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>
