---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { members } from '../../data/site';
---

<Base title="劇団員紹介" description="転回社に所属する俳優・スタッフをご紹介します。">
  <PageHeader jp="劇団員紹介" lead="転回社に所属する俳優・スタッフをご紹介します。出演依頼・お問い合わせは、お問い合わせフォームよりご連絡ください。" />

  <section class="members">
    <div class="container">
      <div class="members__grid">
        {
          members.map((m) => (
            <article class="member">
              <div class="member__photo-wrap">
                <img class="member__photo" src={m.photo} alt={m.name} />
              </div>
              <div class="member__body">
                <p class="member__role">{m.role}</p>
                <h2 class="member__name">{m.name}</h2>
                <p class="member__bio">{m.bio}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="members__cta">
        <p>出演依頼・取材等のご相談は、お問い合わせフォームよりご連絡ください。</p>
        <a class="btn" href="/contact/">お問い合わせへ <span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>
</Base>
