---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import NewsList from '../components/NewsList.astro';
import HomeNewsSpeaker from '../components/HomeNewsSpeaker.astro';
import HomeNewsMarquee from '../components/HomeNewsMarquee.astro';
import Card from '../components/Card.astro';
import BannerLink from '../components/BannerLink.astro';
import StudioMapLink from '../components/StudioMapLink.astro';
import { getHomeNews, getLatestNewsMarquee } from '../utils/news';
import { getCollection } from 'astro:content';
import { studios, homeBanners, corporateBanner, friendsIntro, homeActivities } from '../data/site';
import HomeActivitiesStack from '../components/HomeActivitiesStack.astro';
import HomeActivitiesKeyboard from '../components/HomeActivitiesKeyboard.astro';
import HomeClassesHangLight from '../components/HomeClassesHangLight.astro';
import HomeActivityCard from '../components/HomeActivityCard.astro';
import HomeFriendsIntro from '../components/HomeFriendsIntro.astro';
import { classDetailHref, getHomeClassEntries } from '../utils/classes-content';
import {
  eventEntryCardProps,
  partitionEventList,
  scheduleFromData,
  stageEntryCardSynopsis,
} from '../utils/event-content';
import { compareEntriesUpcoming } from '../utils/schedule';
import {
  formatPerformanceHistoryDateLabel,
  resolveNextPerformanceHistoryItem,
} from '../utils/performance-history';
import { withBase } from '../utils/path';
import HomeHero from '../components/HomeHero.astro';
import HomeSideMarquees from '../components/HomeSideMarquees.astro';
import BadgeMoreLink from '../components/BadgeMoreLink.astro';
import HomeStagesFlyer from '../components/HomeStagesFlyer.astro';

// トップのおしらせ（最大5件）
const news = await getHomeNews();
const latestNewsMarquee = await getLatestNewsMarquee();

const { currentPerformances, currentEvents } = partitionEventList(await getCollection('stages'));
const hasCurrent = currentPerformances.length > 0 || currentEvents.length > 0;
const stageCards = [...currentPerformances, ...currentEvents];
/** 2件: 2列・あらすじ付き sidebar（従来のトップ PC レイアウト） */
const stagesGridPair = stageCards.length === 2;
/** 奇数枚: 空きセルに More（偶数枚は下段） */
const stagesMoreInlineDesktop = stageCards.length > 0 && stageCards.length % 2 === 1;
const homeClasses = await getHomeClassEntries();

const heroMarqueeItems = currentPerformances
  .sort((a, b) =>
    compareEntriesUpcoming(scheduleFromData(a.data), scheduleFromData(b.data)),
  )
  .map((entry) => {
    const nextItem = resolveNextPerformanceHistoryItem(entry.data.performanceHistory);
    return {
      href: `/stages/${entry.id}/`,
      title: entry.data.title,
      dateLabel: nextItem
        ? formatPerformanceHistoryDateLabel(nextItem, { includeTime: true })
        : '',
    };
  });

---

<Base scrollReveal>
  <div class="home">
  <HomeSideMarquees />
  <div class="home-main-guide">
  <HomeHero marqueeItems={heroMarqueeItems} />
  {/* 公演・イベント */}
  <section class="section section--first">
    <div class="container">
      {
        !hasCurrent ? (
          <>
            <SectionHead jp="公演・イベント">
              <HomeStagesFlyer slot="mark" />
            </SectionHead>
            <div class="subsection">
              <p class="empty">現在、公演・イベントの情報はありません。</p>
            </div>
          </>
        ) : (
          <div class="home-stages">
            <div class="home-stages__legend">
              <SectionHead jp="公演・イベント">
                <HomeStagesFlyer slot="mark" />
              </SectionHead>
            </div>
            <div class="home-stages__frame">
              <div
                class:list={[
                  'grid-events',
                  'grid-long-run',
                  stagesGridPair && 'grid-events--pair',
                ]}
              >
                {stageCards.map((entry) => {
                  const synopsis = stagesGridPair ? stageEntryCardSynopsis(entry) : undefined;
                  return (
                    <Card
                      layout="sidebar"
                      href={`/stages/${entry.id}/`}
                      image={entry.data.cover}
                      title={entry.data.title}
                      body={synopsis || undefined}
                      {...eventEntryCardProps(entry.data)}
                    />
                  );
                })}
                {
                  stagesMoreInlineDesktop ? (
                    <div class="grid-events__more grid-events__more--in-grid">
                      <BadgeMoreLink href="/stages/" label="過去の公演・イベント →" />
                    </div>
                  ) : null
                }
              </div>
              {
                !stagesMoreInlineDesktop ? (
                  <div class="section__actions">
                    <BadgeMoreLink href="/stages/" label="過去の公演・イベント →" />
                  </div>
                ) : null
              }
            </div>
          </div>
        )
      }
    </div>
  </section>

  {/* おしらせ */}
  <section class="section section--home-news">
    <div class="container">
      <div class="home-news">
        <header class="home-news__head">
          <h2 class="home-news__title heading-section">おしらせ</h2>
          <HomeNewsSpeaker />
        </header>
        <div class="home-news__main">
          {
            latestNewsMarquee ? (
              <HomeNewsMarquee
                href={latestNewsMarquee.href}
                title={latestNewsMarquee.title}
                body={latestNewsMarquee.body}
              />
            ) : null
          }
          <NewsList
            showNewLabel
            items={news.map((n) => ({
              date: n.date,
              title: n.title,
              href: n.href,
            }))}
          />
          <div class="section__actions section__actions--news">
            <BadgeMoreLink href="/news/" />
          </div>
        </div>
      </div>
    </div>
  </section>
  </div>

  {/* 転回社の活動 */}
  <section class="section section--home-activities scroll-reveal-bg">
    <div class="container">
      <SectionHead
        jp="転回社の活動"
        headingClass="section-head__jp--home-activities"
        scrollReveal
        lead="演劇活動をベースに、|さまざまな活動を行っています。"
      >
        <HomeActivitiesKeyboard slot="mark-start" />
        <HomeActivitiesStack slot="mark" />
      </SectionHead>
      <div class="home-activities">
        {homeActivities.map((activity) => (
          <HomeActivityCard activity={activity} />
        ))}
      </div>
    </div>
  </section>

  {/* 友の会 */}
  <section class="section section--friends-intro">
    <div class="container">
      <HomeFriendsIntro intro={friendsIntro} />
    </div>
  </section>

  {/* 開講クラス */}
  <section class="section section--classes scroll-reveal-bg">
    <div class="container">
      <SectionHead jp="開講クラス" scrollReveal lead="体験参加のお問い合わせもお気軽に！">
        <HomeClassesHangLight slot="mark-start" position="start" />
        <HomeClassesHangLight slot="mark" mirror position="end" />
      </SectionHead>
      <div class="grid-center grid-center--3 home-classes-grid">
        {
          homeClasses.map((entry) => {
            const c = entry.data;
            return (
              <div class="home-classes-grid__cell">
                <Card
                  href={classDetailHref(entry)}
                  image={c.image}
                  title={c.title}
                  body={c.summary}
                  layout="classFlyer"
                />
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ご案内 */}
  <section class="section section--banners">
    <div class="container">
      <SectionHead jp="ご案内" />
      <div class="banner-row banner-row--2">
        {homeBanners.map((b) => (
          <BannerLink href={b.href} title={b.title} english={b.english} light />
        ))}
      </div>
      <div class="banner-row banner-row--1">
        <BannerLink
          href={corporateBanner.href}
          title={corporateBanner.title}
          english={corporateBanner.english}
          wide
          light
        />
      </div>
    </div>
  </section>

  {/* スタジオ所在地・お問い合わせ */}
  <section id="studios" class="section section--footer-links">
    <div class="container">
      <div class="footer-links">
        <div class="footer-links__block">
          <h2 class="footer-links__title">スタジオ所在地</h2>
          <ul class="studio-list">
            {
              studios.map((s) => (
                <li class="studio-list__item">
                  <span class="studio-list__name">{s.name}</span>
                  <StudioMapLink studio={s} inline class="studio-list__addr" />
                </li>
              ))
            }
          </ul>
        </div>
        <div class="footer-links__block footer-links__block--contact">
          <h2 class="footer-links__title">お問い合わせ</h2>
          <p class="footer-links__lead">
            公演・クラス・ワークショップ・取材等に関するお問い合わせは、フォームよりお願いいたします。
          </p>
          <a class="btn btn--pill" href="/contact/">
            お問い合わせフォーム <span class="btn__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  </div>
</Base>
