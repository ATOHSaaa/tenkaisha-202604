---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import NewsList from '../components/NewsList.astro';
import Card from '../components/Card.astro';
import BannerLink from '../components/BannerLink.astro';
import StudioMapLink from '../components/StudioMapLink.astro';
import { getPublishedNews } from '../utils/news';
import { getCollection } from 'astro:content';
import { studios, homeBanners, corporateBanner, friendsIntro, homeActivities } from '../data/site';
import HomeActivityCard from '../components/HomeActivityCard.astro';
import HomeFriendsIntro from '../components/HomeFriendsIntro.astro';
import { classDetailHref, getHomeClassEntries } from '../utils/classes-content';
import {
  eventEntryCardProps,
  partitionEventList,
  scheduleFromData,
} from '../utils/event-content';
import { compareEntriesUpcoming, resolveNextPerformanceDate } from '../utils/schedule';
import { fmtDate } from '../utils/dates';
import { withBase } from '../utils/path';
import HomeHero from '../components/HomeHero.astro';
import BadgeMoreLink from '../components/BadgeMoreLink.astro';

// お知らせを日付降順ですべて取得
const news = await getPublishedNews();

const { currentPerformances, currentEvents } = partitionEventList(await getCollection('stages'));
const hasCurrent = currentPerformances.length > 0 || currentEvents.length > 0;
const homeStageCount = currentPerformances.length + currentEvents.length;
/** 3列グリッドの最終行に空きがあるとき More をセル内に置く（デスクトップ） */
const stagesMoreInlineDesktop = homeStageCount > 0 && homeStageCount % 3 !== 0;
const homeClasses = await getHomeClassEntries();

const heroMarqueeItems = currentPerformances
  .sort((a, b) =>
    compareEntriesUpcoming(scheduleFromData(a.data), scheduleFromData(b.data)),
  )
  .map((entry) => {
    const next = resolveNextPerformanceDate(scheduleFromData(entry.data));
    return {
      href: `/stages/${entry.id}/`,
      title: entry.data.title,
      dateLabel: next ? fmtDate(next) : '',
    };
  });

---

<Base scrollReveal>
  <div class="home">
  <HomeHero marqueeItems={heroMarqueeItems} />
  {/* 公演・イベント */}
  <section class="section section--first">
    <div class="container">
      <SectionHead jp="公演・イベント" />

      <div class="subsection">
        {
          !hasCurrent ? (
            <p class="empty">現在、公演・イベントの情報はありません。</p>
          ) : (
            <div class="grid-events grid-long-run">
              {currentPerformances.map((p) => (
                <Card
                  href={`/stages/${p.id}/`}
                  image={p.data.cover}
                  title={p.data.title}
                  {...eventEntryCardProps(p.data)}
                />
              ))}
              {currentEvents.map((e) => (
                <Card
                  href={`/stages/${e.id}/`}
                  image={e.data.cover}
                  title={e.data.title}
                  {...eventEntryCardProps(e.data)}
                />
              ))}
              {
                stagesMoreInlineDesktop ? (
                  <div class="grid-events__more grid-events__more--in-grid">
                    <BadgeMoreLink href="/stages/" />
                  </div>
                ) : null
              }
            </div>
          )
        }
      </div>

      {
        hasCurrent && !stagesMoreInlineDesktop ? (
          <div class="section__actions section__actions--news">
            <BadgeMoreLink href="/stages/" />
          </div>
        ) : null
      }
    </div>
  </section>

  {/* おしらせ */}
  <section class="section">
    <div class="container">
      <SectionHead jp="おしらせ" />
      <NewsList
        items={news.map((n) => ({
          date: n.date,
          title: n.title,
          href: n.href,
        }))}
      />
      <div class="section__actions section__actions--news">
        <BadgeMoreLink href="/news/" />
      </div>
    </div>
  </section>

  {/* 転回社の活動 */}
  <section class="section section--home-activities">
    <div class="container">
      <SectionHead
        jp="転回社の活動"
        lead="演劇活動をベースに、さまざまな活動を行っています。"
      />
      <div class="home-activities">
        {homeActivities.map((activity) => (
          <HomeActivityCard activity={activity} />
        ))}
      </div>
    </div>
  </section>

  {/* 友の会 */}
  <section class="section section--friends-intro">
    <div class="container">
      <HomeFriendsIntro intro={friendsIntro} />
    </div>
  </section>

  {/* 開講クラス */}
  <section class="section section--classes">
    <div class="container">
      <SectionHead jp="開講クラス" />
      <div class="grid-center grid-center--3">
        {
          homeClasses.map((entry) => {
            const c = entry.data;
            return (
              <Card
                href={classDetailHref(entry)}
                image={c.image}
                title={c.title}
                body={c.summary}
                layout="classFlyer"
              />
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ご案内 */}
  <section class="section section--banners">
    <div class="container">
      <SectionHead jp="ご案内" />
      <div class="banner-row banner-row--2">
        {homeBanners.map((b) => (
          <BannerLink href={b.href} title={b.title} english={b.english} light />
        ))}
      </div>
      <div class="banner-row banner-row--1">
        <BannerLink
          href={corporateBanner.href}
          title={corporateBanner.title}
          english={corporateBanner.english}
          wide
          light
        />
      </div>
    </div>
  </section>

  {/* スタジオ所在地・お問い合わせ */}
  <section id="studios" class="section section--footer-links">
    <div class="container">
      <div class="footer-links">
        <div class="footer-links__block">
          <h2 class="footer-links__title">スタジオ所在地</h2>
          <ul class="studio-list">
            {
              studios.map((s) => (
                <li class="studio-list__item">
                  <span class="studio-list__name">{s.name}</span>
                  <StudioMapLink studio={s} inline class="studio-list__addr" />
                </li>
              ))
            }
          </ul>
        </div>
        <div class="footer-links__block footer-links__block--contact">
          <h2 class="footer-links__title">お問い合わせ</h2>
          <p class="footer-links__lead">
            公演・クラス・ワークショップ・取材等に関するお問い合わせは、フォームよりお願いいたします。
          </p>
          <a class="btn" href="/contact/">
            お問い合わせフォーム <span class="btn__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  </div>
</Base>
