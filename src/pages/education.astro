---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EducationProgramRow from '../components/EducationProgramRow.astro';
import PageContactCta from '../components/PageContactCta.astro';
import { educationPrograms } from '../data/site';
---

<Base title="演劇と教育" description="転回社の演劇教育活動について。学校ワークショップ、子ども向けクラス、刊行物など。">
  <PageHeader jp="演劇と教育" />

  <section class="section education-programs">
    <div class="container">
      <div class="education-programs__flow">
        {
          educationPrograms.map((program) => (
            <EducationProgramRow program={program} />
          ))
        }
      </div>

      <PageContactCta placement="education" />
    </div>
  </section>
</Base>
