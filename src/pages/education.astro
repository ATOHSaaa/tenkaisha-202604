---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import PageContactCta from '../components/PageContactCta.astro';
import { educationPrograms } from '../data/site';
---

<Base title="演劇と教育" description="転回社の演劇教育活動について。学校ワークショップ、子ども向けクラス、刊行物など。">
  <PageHeader jp="演劇と教育" />

  <section class="section education-programs">
    <div class="container">
      <div class="grid grid--3 education-programs__grid">
        {
          educationPrograms.map((program) => (
            <Card
              href={program.path}
              image={program.image}
              title={program.title}
              body={program.summary}
              imageAspect="4/3"
            />
          ))
        }
      </div>

      <PageContactCta body="演劇教育・学校公演・ワークショップ・研修などのご相談は、お問い合わせフォームよりお気軽にご連絡ください。" />
    </div>
  </section>
</Base>
