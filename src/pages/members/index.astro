---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getMembers, memberHref, isMemberNameplate } from '../../utils/members-content';
import { withBase } from '../../utils/path';
import PageContactCta from '../../components/PageContactCta.astro';
---

<Base title="劇団員紹介" description="転回社に所属する俳優・スタッフをご紹介します。" scrollReveal={false}>
  <PageHeader jp="劇団員紹介" lead="転回社に所属する俳優・スタッフをご紹介します。出演依頼・お問い合わせは、お問い合わせフォームよりご連絡ください。" />

  <section class="members">
    <div class="container">
      <div class="members__grid">
        {
          getMembers().map((m) => (
            <a class="member member--link" href={memberHref(m.slug)}>
              <div class="member__photo-wrap">
                <div
                  class:list={[
                    'member__photo-frame',
                    isMemberNameplate(m) && 'member__photo-frame--monogram',
                  ]}
                >
                  {m.photoMonogram ? (
                    <div class="member__photo member__photo--monogram" aria-hidden="true">
                      <span class="member__monogram-label">{m.photoMonogram}</span>
                    </div>
                  ) : (
                    <img
                      class:list={[
                        'member__photo',
                        m.photo?.endsWith('.svg') && 'member__photo--nameplate',
                        m.slug === 'komatsuno-nozomi' && 'member__photo--komatsuno',
                        m.slug === 'sakaguchi-kanoko' && 'member__photo--sakaguchi',
                      ]}
                      src={withBase(m.photo!)}
                      alt=""
                      loading="lazy"
                    />
                  )}
                </div>
              </div>
              <div class="member__body">
                <p class="member__role">{m.role}</p>
                <h2 class="member__name">{m.name}</h2>
              </div>
            </a>
          ))
        }
      </div>

      <PageContactCta placement="members" />
    </div>
  </section>
</Base>
