---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import { publications } from '../../data/site';
---

<Base title="刊行物" description="転回社が発行する刊行物のご紹介。">
  <PageHeader jp="刊行物" lead="転回社の活動から派生した、記録・事例集などの刊行物をご紹介します。" />

  <section class="pubs">
    <div class="container">
      <div class="grid grid--3 pubs__grid">
        {
          publications.map((p, i) => (
            <Card
              href={p.path}
              image={p.cover}
              label={`VOL.0${i + 1} / ${p.year}`}
              title={p.title}
              body={p.summary}
              imageAspect="5/7"
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>
