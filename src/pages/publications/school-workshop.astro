---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import WorkshopCasebookToc from '../../components/WorkshopCasebookToc.astro';
import { publications } from '../../data/site';
import { schoolWorkshopCopy } from '../../data/school-workshop-copy';
import { workshopCasebookCover } from '../../data/workshop-casebook';
import { withBase } from '../../utils/path';

const p = publications.find((x) => x.slug === 'school-workshop')!;
const coverSrc = withBase(workshopCasebookCover);
const copy = schoolWorkshopCopy.casebookPage;
---

<Base title={p.title} description={p.summary}>
  <PageHeader jp="『演劇ワークショップ事例集』" compact />

  <article class="pub pub--casebook">
    <section class="container pub__body">
      <div class="pub__grid">
        <div class="prose">
          {copy.intro.map((paragraph) => <p>{paragraph}</p>)}

          <h2>目次</h2>
          <WorkshopCasebookToc />

          <h2>{copy.audienceHeading}</h2>
          <ul>
            {copy.audience.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <h2>{copy.contactHeading}</h2>
          <p>
            {copy.contactBeforeLink}
            <a href={withBase('/contact/')}>{copy.contactLinkLabel}</a>
            {copy.contactAfterLink}
          </p>
        </div>

        <aside class="pub__side">
          <img
            class="pub__cover pub__cover--contain"
            src={coverSrc}
            alt=""
            width={724}
            height={1024}
            loading="lazy"
            decoding="async"
          />
          <dl class="pub__spec">
            <div><dt>刊行</dt><dd>{p.year}年</dd></div>
            <div><dt>発行</dt><dd>{copy.sidebar.publisher}</dd></div>
          </dl>
          <a class="btn btn--pill" href={withBase('/contact/')}>
            {copy.sidebar.ctaLabel} <span class="btn__arrow">→</span>
          </a>
        </aside>
      </div>
    </section>
  </article>
</Base>
