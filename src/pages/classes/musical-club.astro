---
import Base from '../../layouts/Base.astro';
import ClassDetail from '../../components/ClassDetail.astro';
import { classes } from '../../data/site';

const c = classes.find((x) => x.slug === 'musical-club')!;
---

<Base title={c.name}>
  <ClassDetail
    class={c}
    paragraphs={[
      '私たち熊本ミュージカルクラブは、週に一回、国府電停そばのスタジオに集まって、楽しくミュージカル活動をしています。',
      '元劇団四季の小松野希海と一緒に、ミュージカルの世界を体験してみませんか？活動は毎週一回（火曜日）なので、仕事や学校に行きながらでも、気軽に参加できます。ミュージカルが好きな人なら、どなたでも大歓迎です。',
      'みなさんと一緒にミュージカルをできる日を、楽しみにしています。体験は、お問い合わせフォームからお申し込みください。',
    ]}
  />
</Base>
