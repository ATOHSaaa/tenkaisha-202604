---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import { classDetailHref, getClassEntries } from '../../utils/classes-content';
import PageContactCta from '../../components/PageContactCta.astro';

const classes = await getClassEntries();
---

<Base title="開講クラス" description="熊本ミュージカルクラブ・転回社ジュニアクラス・くまもと発声表現教室の稽古日、対象、月謝のご案内。">
  <PageHeader jp="開講クラス" />

  <section class="classes">
    <div class="container">
      <div class="grid grid--3 classes__grid">
        {
          classes.map((entry) => {
            const c = entry.data;
            return (
              <Card
                href={classDetailHref(entry)}
                image={c.image}
                title={c.title}
                body={c.summary}
                layout="classFlyer"
              >
                <dl class="classes__meta">
                  {c.target && <div><dt>対象</dt><dd>{c.target}</dd></div>}
                  {c.schedule && <div><dt>稽古日</dt><dd>{c.schedule}</dd></div>}
                  {c.fee && <div><dt>月謝</dt><dd>{c.fee}</dd></div>}
                </dl>
              </Card>
            );
          })
        }
      </div>

      <PageContactCta />
    </div>
  </section>
</Base>
