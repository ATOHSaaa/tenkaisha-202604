---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import { classDetailHref, getClassEntries } from '../../utils/classes-content';

const classes = await getClassEntries();
---

<Base title="開講クラス" description="転回社が運営する3つのクラス（熊本ミュージカルクラブ・転回社ジュニアクラス・くまもと発声表現教室）の情報。">
  <PageHeader jp="開講クラス" lead="転回社では、4つのクラスを常設で運営しています。見学・体験のご要望もお気軽にどうぞ。" />

  <section class="classes">
    <div class="container">
      <div class="grid grid--2 classes__grid">
        {
          classes.map((entry) => {
            const c = entry.data;
            return (
              <Card
                href={classDetailHref(entry)}
                image={c.image}
                label={c.english}
                title={c.title}
                body={c.summary}
                imageAspect="4/3"
              >
                <dl class="classes__meta">
                  {c.target && <div><dt>対象</dt><dd>{c.target}</dd></div>}
                  {c.schedule && <div><dt>稽古日</dt><dd>{c.schedule}</dd></div>}
                  {c.fee && <div><dt>月謝</dt><dd>{c.fee}</dd></div>}
                </dl>
              </Card>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>
