---
import Base from '../../layouts/Base.astro';
import ClassDetail from '../../components/ClassDetail.astro';
import { classes } from '../../data/site';

const c = classes.find((x) => x.slug === 'hassei')!;
---

<Base title={c.name}>
  <ClassDetail
    class={c}
    description="くまもと発声表現教室は、演劇の手法を活かした大人向けの発声・表現の教室です。呼吸・姿勢・発声の基礎から、プレゼンテーションや日常の話し方にも活かせる表現力まで、幅広く学べます。"
    highlights={[
      '呼吸・姿勢・発声の基礎からスタート',
      'ビジネスや日常の話し方にも応用可能',
      '1回完結型のワークショップ回あり',
      '個別相談・カウンセリングを随時実施',
    ]}
  />
</Base>
