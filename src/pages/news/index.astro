---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsList from '../../components/NewsList.astro';
import NewsWithSidebar from '../../components/NewsWithSidebar.astro';
import { getPublishedNews } from '../../utils/news';

const news = await getPublishedNews();
---

<Base title="おしらせ" description="転回社からのおしらせ一覧。">
  <div class="news-page">
    <PageHeader jp="おしらせ" />

    <section class="news">
      <div class="container">
        <NewsWithSidebar>
          <NewsList
            items={news.map((n) => ({
              date: n.date,
              title: n.title,
              href: n.href,
            }))}
          />
        </NewsWithSidebar>
      </div>
    </section>
  </div>
</Base>
