---
import NotFoundPage from '../../components/NotFoundPage.astro';
import Base from '../../layouts/Base.astro';
import NewsWithSidebar from '../../components/NewsWithSidebar.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

export const prerender = true;

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

const entry = slug ? await getEntry('news', slug).catch(() => undefined) : undefined;
const notFound = !slug || !entry;

if (notFound) {
  Astro.response.status = 404;
}

if (entry?.data.link) {
  return Astro.redirect(entry.data.link);
}

const { Content } = entry ? await render(entry) : { Content: null };

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

{
  notFound || !entry ? (
    <NotFoundPage />
  ) : (
    <Base title={entry.data.title} description={entry.data.title}>
      <article class="news-detail">
        <section class="news">
          <div class="container">
            <NewsWithSidebar>
              <header class="news-detail__header">
                <h1 class="news-detail__title heading-section">{entry.data.title}</h1>
                <p class="news-detail__meta">
                  <time class="news-detail__date" datetime={entry.data.date.toISOString()}>
                    {fmtDate(entry.data.date)}
                  </time>
                </p>
              </header>
              <div class="news-detail__frame news-detail__column">
                <div class="prose news-detail__prose">
                  {Content && <Content />}
                </div>
              </div>
            </NewsWithSidebar>
          </div>
        </section>
      </article>
    </Base>
  )
}
